import argparse
import json
import os
import random
import time
from pathlib import Path

from ga_adapters.runner_bridge import RunnerBridge

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pair", default="BTCUSDT")
    ap.add_argument("--population", type=int, default=12)
    ap.add_argument("--generations", type=int, default=5)
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--max_bars", type=int, default=60000, help="limits data used by backtest_runner_v3 (via env FRANK_MAX_BARS)")
    args = ap.parse_args()

    random.seed(args.seed)

    # Ensure speed limit for backtest_runner_v3 (RunnerBridge detects --max_bars support)
    os.environ["FRANK_MAX_BARS"] = str(max(1000, int(args.max_bars)))

    out = Path("results_ga") / f"ga_smoke_{time.strftime('%Y%m%d_%H%M%S')}"
    out.mkdir(parents=True, exist_ok=True)

    print(f"[GA] out={out.resolve()}")
    print(f"[GA] pair={args.pair} pop={args.population} gens={args.generations} seed={args.seed} max_bars={os.environ.get('FRANK_MAX_BARS')}")

    rb = RunnerBridge(out_dir=str(out))

    # simple param sampler (safe ranges)
    def sample_params():
        return {
            "tp": random.uniform(0.0015, 0.0100),
            "sl": random.uniform(0.0010, 0.0080),
            "cooldown": random.randint(5, 90),
            "atr_mult": random.uniform(0.5, 3.0),
        }

    def score(meta: dict) -> float:
        # robust get
        net   = float(meta.get("net", 0.0))
        fees  = float(meta.get("fees", 0.0))
        dd    = float(meta.get("dd", 0.0))
        trades = int(meta.get("trades", 0))
        # prefer: positive net, low fees/dd, enough trades
        return (net * 10.0) - (fees * 1.0) - (dd * 2.0) + (min(trades, 200) * 0.02)

    best = None

    for gen in range(args.generations):
        gen_best = None
        for i in range(args.population):
            params = sample_params()
            meta = rb.eval_once(args.pair, params)  # subprocess to backtest_runner_v3
            sc = score(meta)
            if (gen_best is None) or (sc > gen_best[0]):
                gen_best = (sc, params, meta)
            if (best is None) or (sc > best[0]):
                best = (sc, params, meta)
        bsc, bpa, bme = gen_best
        print(f"[GA] gen={gen} best_score={bsc:.4f} trades={int(bme.get('trades',0))} net={float(bme.get('net',0.0)):.6f} fees={float(bme.get('fees',0.0)):.6f} dd={float(bme.get('dd',0.0)):.6f}")

    if best:
        bsc, bpa, bme = best
        payload = {
            "best_score": bsc,
            "best_params": bpa,
            "best_meta": bme,
            "pair": args.pair,
            "seed": args.seed,
            "max_bars": int(os.environ.get("FRANK_MAX_BARS", "0") or 0),
            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        (out / "best.json").write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"[GA] saved: {(out / 'best.json').resolve()}")

if __name__ == "__main__":
    main()