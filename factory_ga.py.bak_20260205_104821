import time, argparse, random, json, sys, logging
from pathlib import Path
from ga_adapters.runner_bridge import RunnerBridge

# Prepare result directories and logging
ROOT = Path(__file__).resolve().parent
args_parser = argparse.ArgumentParser()
args_parser.add_argument("--pair", required=True, help="Trading pair symbol, e.g. SOLUSDT")
args_parser.add_argument("--population", type=int, default=20, help="GA population size")
args_parser.add_argument("--generations", type=int, default=0, help="Number of generations to run (0 for infinite)")
args_parser.add_argument("--bars", type=int, default=60000, help="Number of bars (historical data length)")
args_parser.add_argument("--timeout_sec", type=int, default=900, help="Max seconds to wait for each backtest evaluation")
args_parser.add_argument("--seed", type=int, default=42, help="Random seed for reproducibility")
args_parser.add_argument("--notional", type=float, default=50.0, help="Position notional (USDT) for each trade")
args = args_parser.parse_args()

pair = args.pair
random.seed(args.seed)
pair_dir = ROOT / "results_ga" / "factory_top" / pair
pair_dir.mkdir(parents=True, exist_ok=True)

# Configure logging (file and console)
log_file = pair_dir / "log.txt"
logger = logging.getLogger(f"GA-{pair}")
logger.setLevel(logging.INFO)
formatter = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s", "%Y-%m-%d %H:%M:%S")
file_handler = logging.FileHandler(str(log_file), mode="a", encoding="utf-8")
file_handler.setLevel(logging.INFO)
file_handler.setFormatter(formatter)
console_handler = logging.StreamHandler(sys.stdout)
console_handler.setLevel(logging.INFO)
console_handler.setFormatter(formatter)
logger.addHandler(file_handler)
logger.addHandler(console_handler)
logger.info(f"Starting genetic optimization for {pair} (population={args.population}, seed={args.seed})")

# Helper to extract performance metrics from backtest report
def extract_metrics(rep: dict, pair: str) -> dict:
    p = rep.get("pairs", {}).get(pair, {})
    summ = rep.get("summary", {})
    train_bars = int(p.get("train_bars") or 0)
    test_bars = int(p.get("test_bars") or 0)
    bars_total = train_bars + test_bars if (train_bars or test_bars) else int(p.get("total_bars", 0) or summ.get("total_test_bars", 0) or 0)
    tm = p.get("test_metrics") or p.get("metrics") or {}
    trades = tm.get("trades") or tm.get("total_trades") or summ.get("total_test_trades", 0) or 0
    net = tm.get("net_pnl") or tm.get("pnl") or summ.get("total_test_net_pnl", 0.0) or 0.0
    fees = tm.get("fees") or tm.get("total_fees") or summ.get("total_test_fees", 0.0) or 0.0
    dd = tm.get("max_drawdown") or tm.get("max_dd") or summ.get("avg_test_drawdown", 0.0) or 0.0
    try: trades = int(trades)
    except: trades = 0
    try: net = float(net)
    except: net = 0.0
    try: fees = float(fees)
    except: fees = 0.0
    try: dd = float(dd)
    except: dd = 0.0
    return {"trades": trades, "net_pnl": net, "fees": fees, "max_dd": dd, "bars": bars_total}

# Fitness function (maximize net profit, penalize high drawdown slightly)
def score_fitness(metrics: dict) -> float:
    if metrics["trades"] <= 0:
        return -1e9  # discourage strategies that make no trades
    # Score: net profit minus 0.25 * (drawdown * net profit) for risk adjustment
    return metrics["net_pnl"] - 0.25 * abs(metrics["max_dd"]) * abs(metrics["net_pnl"])

# Load existing top-50 results (parameters and performance) to seed the GA
best_records = []
for file in pair_dir.glob("best_*.json"):
    try:
        data = json.loads(file.read_text())
    except Exception as e:
        logger.error(f"Error reading {file.name}: {e}")
        continue
    net_val = None
    if "metrics" in data and "net_pnl" in data["metrics"]:
        net_val = float(data["metrics"]["net_pnl"])
    elif "net_pnl" in data:
        net_val = float(data["net_pnl"])
    if net_val is None:
        continue
    params = data.get("parameters") or data.get("params") or {}
    best_records.append({"net": net_val, "params": params, "file": file})
best_records.sort(key=lambda x: x["net"], reverse=True)
if len(best_records) > 50:
    # If more than 50 stored, remove the extras (lowest net ones)
    for rec in best_records[50:]:
        try:
            rec["file"].unlink()
        except Exception as e:
            logger.warning(f"Failed to remove old file {rec['file'].name}: {e}")
    best_records = best_records[:50]
if best_records:
    logger.info(f"Loaded {len(best_records)} previous top configs (best net_pnl={best_records[0]['net']:.2f}, worst={best_records[-1]['net']:.2f}) for seeding.")

# Save a new top configuration to disk
def save_best_candidate(params: dict, metrics: dict):
    record = {
        "pair": pair,
        "parameters": params,
        "metrics": {"net_pnl": metrics["net_pnl"], "trades": metrics["trades"], "max_drawdown": metrics["max_dd"]}
    }
    ts = int(time.time() * 1000)
    file_path = pair_dir / f"best_{ts}.json"
    counter = 1
    while file_path.exists():
        file_path = pair_dir / f"best_{ts}_{counter}.json"
        counter += 1
    try:
        file_path.write_text(json.dumps(record, ensure_ascii=False, indent=2))
        logger.debug(f"Saved new top parameters to {file_path.name} (net_pnl={metrics['net_pnl']:.2f})")
        return file_path
    except Exception as e:
        logger.error(f"Could not save best config file: {e}")
        return None

# Initialize population of strategies
population = []
# Use some of the previous best configurations as part of initial population for faster convergence
if best_records:
    use_count = min(len(best_records), max(2, args.population // 2))
    for rec in best_records[:use_count]:
        # Ensure all required keys are present in the param set (fill missing with defaults)
        params = rec["params"].copy()
        defaults = {
            "entry_variant": 0, "rsi_buy": 30.0, "breakout_atr_k": 0.2,
            "k_tp": 0.5, "k_sl": 1.5, "tp_min_usdt": 0.0, "sl_min_usdt": 0.0,
            "target_profit_min_usdt": 0.0, "max_hold_bars": 30, "min_atr_multiplier": 1.0,
            "use_trend_filter": 0, "use_bb_filter": 0, "breakout_lookback": 20
        }
        for k, v in defaults.items():
            if k not in params:
                params[k] = v
        population.append(params)
    logger.info(f"Seeded initial population with {use_count} top configurations from history.")
# Fill the rest of the population with random parameter sets
while len(population) < args.population:
    individual = {
        "entry_variant": random.choice([0, 1, 2, 3]),
        "rsi_buy": random.uniform(10.0, 60.0),
        "breakout_atr_k": random.uniform(0.01, 2.0),
        "k_tp": random.uniform(0.0, 3.0),
        "k_sl": random.uniform(0.0, 3.0),
        "tp_min_usdt": random.uniform(0.0, 1.0),
        "sl_min_usdt": random.uniform(0.0, 1.0),
        "target_profit_min_usdt": random.uniform(0.0, 1.0),
        "max_hold_bars": random.randint(5, 100),
        "min_atr_multiplier": random.uniform(0.5, 2.0),
        "use_trend_filter": random.choice([0, 1]),
        "use_bb_filter": random.choice([0, 1]),
        "breakout_lookback": random.randint(5, 50)
    }
    population.append(individual)

# Prepare the backtest runner (external simulation engine)
rb = RunnerBridge(out_dir=str(pair_dir), python_exe=sys.executable)

global_best_net = best_records[0]["net"] if best_records else float("-inf")
generation = 0

try:
    max_generations = args.generations if args.generations and args.generations > 0 else float("inf")
    while generation < max_generations:
        generation += 1
        scored_population = []  # will hold tuples of (fitness, params, metrics)
        # Evaluate each individual strategy configuration
        for indiv in population:
            # Merge strategy parameters with fixed simulation settings
            config = indiv.copy()
            config.update({
                "max_bars": int(args.bars),
                "notional_usdt": float(args.notional),
                "no_optimize": True
            })
            try:
                rep = rb.eval_once(pair, config, timeout_sec=args.timeout_sec)
            except Exception as e:
                logger.error(f"Backtest error for config (entry_variant={config.get('entry_variant')}): {e}")
                continue
            if not rep or "pairs" not in rep:
                logger.error("No report returned (timeout or error). Skipping this individual.")
                continue
            # Get metrics from the backtest result
            metrics = extract_metrics(rep, pair)
            fitness = score_fitness(metrics)
            scored_population.append((fitness, indiv, metrics))
        if not scored_population:
            logger.error("Generation produced no valid results; stopping GA to avoid infinite loop.")
            break

        # Rank individuals by fitness (higher is better)
        scored_population.sort(key=lambda x: x[0], reverse=True)
        best_score, best_params, best_metrics = scored_population[0]
        # Check if we found a new all-time best
        improved_flag = ""
        if best_metrics["net_pnl"] > global_best_net:
            global_best_net = best_metrics["net_pnl"]
            improved_flag = " <<< NEW HIGH NET_PNL"
            new_file = save_best_candidate(best_params, best_metrics)
            if new_file:
                best_records.append({"net": best_metrics["net_pnl"], "params": best_params, "file": new_file})
                best_records.sort(key=lambda x: x["net"], reverse=True)
                if len(best_records) > 50:
                    worst = best_records.pop()  # remove lowest performer from list
                    if worst["file"]:
                        try:
                            worst["file"].unlink()
                        except Exception as e:
                            logger.warning(f"Failed to delete worst config file {worst['file'].name}: {e}")
        # Log the best individual of this generation
        logger.info(f"Gen {generation}: best_net={best_metrics['net_pnl']:.2f}, trades={best_metrics['trades']}, drawdown={best_metrics['max_dd']:.3f}, config: "
                    f"ev={best_params['entry_variant']}, rsi={best_params['rsi_buy']:.1f}, ATR_k={best_params['breakout_atr_k']:.2f}, k_tp={best_params['k_tp']:.2f}, "
                    f"k_sl={best_params['k_sl']:.2f}, trend={best_params['use_trend_filter']}, bb={best_params['use_bb_filter']}, lookback={best_params['breakout_lookback']}, "
                    f"hold={best_params['max_hold_bars']}, atr_min={best_params['min_atr_multiplier']:.2f}, tp_min={best_params['tp_min_usdt']:.2f}, sl_min={best_params['sl_min_usdt']:.2f}, "
                    f"target_min={best_params['target_profit_min_usdt']:.2f}{improved_flag}")

        # Reproduce next generation via elitism and mutations
        next_population = []
        # Carry over 2 elite (best) individuals without changes
        elites = [rec[1] for rec in scored_population[:2]]
        for elite in elites:
            next_population.append(elite.copy())
        # Fill the rest of the population with offspring of top performers
        while len(next_population) < args.population:
            parent = scored_population[random.randint(0, min(4, len(scored_population)-1))][1]  # choose a parent from top 5
            child = parent.copy()
            # Mutations:
            if random.random() < 0.1:
                # Randomly change entry variant (different entry logic)
                child["entry_variant"] = random.choice([0, 1, 2, 3])
            # Adjust RSI threshold by up to ±15%
            child["rsi_buy"] *= random.uniform(0.85, 1.15)
            child["rsi_buy"] = min(60.0, max(10.0, child["rsi_buy"]))
            # Adjust breakout ATR multiplier by ±20%
            child["breakout_atr_k"] *= random.uniform(0.8, 1.2)
            child["breakout_atr_k"] = min(2.0, max(0.01, child["breakout_atr_k"]))
            # Adjust take-profit and stop-loss multipliers by ±20%
            child["k_tp"] *= random.uniform(0.8, 1.2);  child["k_tp"] = min(5.0, max(0.0, child["k_tp"]))
            child["k_sl"] *= random.uniform(0.8, 1.2);  child["k_sl"] = min(5.0, max(0.0, child["k_sl"]))
            # Adjust absolute TP/SL/target profit floors by ±50%
            child["tp_min_usdt"] *= random.uniform(0.5, 1.5);  child["tp_min_usdt"] = min(5.0, max(0.0, child["tp_min_usdt"]))
            child["sl_min_usdt"] *= random.uniform(0.5, 1.5);  child["sl_min_usdt"] = min(5.0, max(0.0, child["sl_min_usdt"]))
            child["target_profit_min_usdt"] *= random.uniform(0.5, 1.5)
            child["target_profit_min_usdt"] = min(5.0, max(0.0, child["target_profit_min_usdt"]))
            # Adjust max hold bars by ±20% (ensure at least 1, cap at dataset length)
            if child["max_hold_bars"] < 1:
                child["max_hold_bars"] = 1
            delta_bars = int(child["max_hold_bars"] * random.uniform(-0.2, 0.2))
            child["max_hold_bars"] = min(60000, max(1, child["max_hold_bars"] + delta_bars))
            # Adjust minimum ATR multiplier by ±50%
            child["min_atr_multiplier"] *= random.uniform(0.5, 1.5)
            child["min_atr_multiplier"] = min(5.0, max(0.1, child["min_atr_multiplier"]))
            # Randomly flip trend/Bollinger filters on/off (10% chance each)
            if random.random() < 0.1:
                child["use_trend_filter"] = 1 - child["use_trend_filter"]
            if random.random() < 0.1:
                child["use_bb_filter"] = 1 - child["use_bb_filter"]
            # Adjust breakout lookback window by ±20% (at least 1)
            delta_lookback = int(child["breakout_lookback"] * random.uniform(-0.2, 0.2))
            if delta_lookback == 0:
                delta_lookback = random.choice([-1, 1])
            child["breakout_lookback"] = min(200, max(1, child["breakout_lookback"] + delta_lookback))
            next_population.append(child)
        # Update population for next generation
        population = next_population[:args.population]
        # (Optional) Insert a short sleep or yield if needed to throttle loop or handle external signals

except KeyboardInterrupt:
    logger.info("Graceful shutdown (Ctrl+C) received. Exiting GA loop.")
except Exception as e:
    logger.exception(f"Unexpected error in GA optimization: {e}")
finally:
    logger.info(f"GA optimization finished for {pair}.")
    # Flush and close log handlers
    for h in logger.handlers:
        try:
            h.flush()
            h.close()
        except:
            pass