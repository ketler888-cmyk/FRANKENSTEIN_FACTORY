import re
from pathlib import Path

ENTRY_SRC = r'''
def entry_signal(e9, e21, rr, cc, mid):
    """
    Global compat helper for fast-path runners.
    Expected call-site: entry_signal(e9, e21, rr, cc, mid)
    """
    try:
        ok_trend = (e9 is not None) and (e21 is not None) and (float(e9) > float(e21))
    except Exception:
        ok_trend = True

    try:
        r = float(rr) if rr is not None else None
        ok_rsi = (r is not None) and (35.0 <= r <= 65.0)
    except Exception:
        ok_rsi = True

    try:
        ok_bb = (cc is not None) and (mid is not None) and (float(cc) <= float(mid))
    except Exception:
        ok_bb = True

    return bool(ok_trend and ok_rsi and ok_bb)
'''.lstrip()

def patch_one(path: Path) -> bool:
    if not path.exists():
        return False

    s = path.read_text(encoding="utf-8", errors="replace")

    # If there is a top-level def entry_signal(...): replace it fully.
    # Otherwise inject before first class BacktestRunner (or at top after imports).
    m = re.search(r'(?m)^def\\s+entry_signal\\s*\\([^\\)]*\\)\\s*:\\s*$', s)
    if m:
        # replace the whole function block (until next top-level def/class or EOF)
        start = m.start()
        tail = s[start:]
        m2 = re.search(r'(?m)^(def\\s+\\w+\\s*\\(|class\\s+\\w+\\s*\\(|if\\s+__name__\\s*==\\s*[\\'"]__main__[\\'"]\\s*:)', tail[1:])
        end = start + (m2.start()+1 if m2 else len(tail))
        s2 = s[:start] + ENTRY_SRC + "\\n" + s[end:]
        path.write_text(s2, encoding="utf-8")
        print(f"OK: replaced existing entry_signal in {path.name}")
        return True

    # inject
    inject_at = None
    m_cls = re.search(r'(?m)^class\\s+BacktestRunner\\b', s)
    if m_cls:
        inject_at = m_cls.start()
    else:
        # after imports block if possible
        m_imp_last = None
        for mm in re.finditer(r'(?m)^(import\\s+.+|from\\s+.+\\s+import\\s+.+)\\s*$', s):
            m_imp_last = mm
        inject_at = (m_imp_last.end() + 1) if m_imp_last else 0

    s2 = s[:inject_at] + "\\n" + ENTRY_SRC + "\\n" + s[inject_at:]
    path.write_text(s2, encoding="utf-8")
    print(f"OK: injected entry_signal into {path.name}")
    return True

changed = False
changed |= patch_one(Path("backtest_runner_v3.py"))
changed |= patch_one(Path("backtest_runner.py"))
print("DONE. changed=", changed)