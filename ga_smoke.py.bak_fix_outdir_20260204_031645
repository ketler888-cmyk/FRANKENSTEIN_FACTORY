import os
import sys
import json
import time
import argparse
import random
from pathlib import Path

ROOT = os.path.abspath(os.path.dirname(__file__))
sys.path.insert(0, ROOT)

from backtest_runner import BacktestRunner  # keep current runner

def load_ohlc(pair: str, bars: int):
    # Your project already has a loader inside BacktestRunner; we reuse it via runner.
    # But for simplicity we call runner.load_pair_ohlc after runner exists.
    raise RuntimeError("load_ohlc is not used directly")

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pair", default="SOLUSDT")
    ap.add_argument("--bars", type=int, default=60000)   # was huge; smoke should be quick
    ap.add_argument("--notional", type=float, default=50.0)
    ap.add_argument("--population", type=int, default=24)
    ap.add_argument("--generations", type=int, default=20)
    ap.add_argument("--elite", type=int, default=6)
    ap.add_argument("--seed", type=int, default=42)
    args = ap.parse_args()

    random.seed(args.seed)

    out = Path(ROOT) / "results_ga" / ("ga_smoke_" + time.strftime("%Y%m%d_%H%M%S"))
    out.mkdir(parents=True, exist_ok=True)

    print(f"[GA] out={out}")
    print(f"[GA] pair={args.pair} bars={args.bars} notional={args.notional} pop={args.population} gens={args.generations} elite={args.elite} seed={args.seed}")

    # IMPORTANT FIX:
    # Create runner ONCE so indicator cache is reused across evaluations.
    cache_dir = out / "cache"
    cache_dir.mkdir(parents=True, exist_ok=True)

    runner = BacktestRunner(
        data_dir=Path(ROOT) / "SCALPING_DATA_PARQUET",
        out_dir=out,
        cache_dir=cache_dir,
        tp_pct=0.004,
        sl_pct=0.002,
        notional=args.notional,
    )

    ohlc = runner.load_pair_ohlc(args.pair)
    if args.bars and args.bars > 0 and len(ohlc) > args.bars:
        ohlc = ohlc.tail(args.bars).copy()

    # individual is simple dict for smoke
    def mk_ind():
        # keep ranges close to scalping reality
        return {
            "tp": random.uniform(0.0025, 0.0100),
            "sl": random.uniform(0.0015, 0.0080),
        }

    def eval_ind(ind):
        # update tp/sl WITHOUT recreating runner
        runner.tp_pct = float(ind["tp"])
        runner.sl_pct = float(ind["sl"])
        res = runner.run_pair_fast(args.pair, ohlc)
        score = float(res.get("score", 0.0))
        meta = {
            "tp": runner.tp_pct,
            "sl": runner.sl_pct,
            "trades": int(res.get("trades", 0)),
            "net": float(res.get("net", 0.0)),
            "fees": float(res.get("fees", 0.0)),
            "dd": float(res.get("dd", 0.0)),
        }
        return score, meta

    pop = [mk_ind() for _ in range(args.population)]
    best = None

    try:
        for gen in range(args.generations):
            scored = []
            for ind in pop:
                sc, meta = eval_ind(ind)
                scored.append((sc, ind, meta))

            scored.sort(key=lambda x: x[0], reverse=True)
            top = scored[0]
            if (best is None) or (top[0] > best[0]):
                best = top

            bsc, bind, bmeta = best
            print(f"[GA] gen={gen} best_score={bsc:.6f} tp={bmeta['tp']:.6f} sl={bmeta['sl']:.6f} trades={bmeta['trades']} net={bmeta['net']:.6f} fees={bmeta['fees']:.6f} dd={bmeta['dd']:.6f}")

            # elitism
            elites = scored[:max(1, args.elite)]
            new_pop = [e[1] for e in elites]

            # mutate to refill
            while len(new_pop) < args.population:
                parent = random.choice(elites)[1]
                child = dict(parent)
                # small mutations
                child["tp"] = min(0.0200, max(0.0010, child["tp"] * random.uniform(0.85, 1.15)))
                child["sl"] = min(0.0200, max(0.0010, child["sl"] * random.uniform(0.85, 1.15)))
                new_pop.append(child)

            pop = new_pop

    except KeyboardInterrupt:
        print("[GA] KeyboardInterrupt: stopping early; writing partial results...")

    # save best
    if best:
        bsc, bind, bmeta = best
        payload = {
            "best_score": bsc,
            "best_params": bind,
            "best_meta": bmeta,
            "pair": args.pair,
            "bars": int(args.bars),
            "notional": float(args.notional),
            "seed": int(args.seed),
            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        (out / "best.json").write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"[GA] saved: {out / 'best.json'}")

if __name__ == "__main__":
    main()