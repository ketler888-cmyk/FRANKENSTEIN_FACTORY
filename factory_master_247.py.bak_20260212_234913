def normalize_pair(p: str) -> str:
    if p is None:
        return p
    p = str(p).strip().upper()
    # BTC/USDT -> BTCUSDT, BTC-USDT -> BTCUSDT, BTC_USDT -> BTCUSDT
    p = p.replace("/", "").replace("-", "").replace("_", "")
    return p

def load_factory_config(root: Path):
    cfg = root / "configs" / "factory_config.json"
    if not cfg.exists():
        return {}
    try:
        return json.loads(cfg.read_text(encoding="utf-8"))
    except Exception:
        try:
            return json.loads(cfg.read_text(encoding="utf-8-sig"))
        except Exception:
            return {}

