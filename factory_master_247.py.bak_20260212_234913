import re
import subprocess
from typing import List, Set

def _ga_supported_args(py_exe: str, root_dir: str) -> Set[str]:
    # returns option tokens like {'--pair','--population',...}
    try:
        p = subprocess.run(
            [py_exe, "factory_ga.py", "-h"],
            capture_output=True, text=True, cwd=root_dir
        )
        help_txt = (p.stdout or "") + "\n" + (p.stderr or "")
    except Exception:
        return set()
    return set(re.findall(r'(?m)(--[a-zA-Z0-9_\-]+)', help_txt))

def _filter_ga_args(args: List[str], supported: Set[str]) -> List[str]:
    if not supported:
        return args
    out: List[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if isinstance(a, str) and a.startswith("--"):
            if a in supported:
                out.append(a)
                if i + 1 < len(args) and (not str(args[i+1]).startswith("--")):
                    out.append(args[i+1])
                    i += 2
                    continue
                i += 1
                continue
            else:
                # drop unknown flag and its value (if any)
                if i + 1 < len(args) and (not str(args[i+1]).startswith("--")):
                    i += 2
                else:
                    i += 1
                continue
        else:
            out.append(a)
            i += 1
    return out
# === FRANKEN_HELPER_END ===

