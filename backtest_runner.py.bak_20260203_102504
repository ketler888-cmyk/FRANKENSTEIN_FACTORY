def _fr_load_ohlc_for_pair(pair: str, root_dir: str):
    """
    Prefer Parquet from SCALPING_DATA_PARQUET, fallback to CSV from SCALPING_DATA.
    You can override folders via env:
      FR_OHLCV_PARQUET_DIR, FR_OHLCV_CSV_DIR
    """
    import pandas as pd

    root = Path(root_dir)

    pq_dir = Path(os.getenv("FR_OHLCV_PARQUET_DIR", str(root / "SCALPING_DATA_PARQUET")))
    csv_dir = Path(os.getenv("FR_OHLCV_CSV_DIR",     str(root / "SCALPING_DATA")))

    pq = pq_dir / f"{pair}_1m.parquet"
    csv = csv_dir / f"{pair}_1m.csv"

    if pq.exists():
        df = pd.read_parquet(pq)  # pyarrow
        return df, str(pq)

    if csv.exists():
        # FR: prefer parquet for OHLC if available
        __csv_path = csv
        __parq_path = str(__csv_path)
        __parq_path = __parq_path.replace('SCALPING_DATA','SCALPING_DATA_PARQUET')
        if __parq_path.lower().endswith('.csv'):
            __parq_path = __parq_path[:-4] + '.parquet'
        if os.path.exists(__parq_path):
            df = pd.read_parquet(__parq_path)
        else:
            df = pd.read_csv(__csv_path)
        return df, str(csv)

    raise FileNotFoundError(f"No OHLCV found for {pair}. Checked: {pq} and {csv}")


class ExitReason(str, Enum):
    TAKE_PROFIT = "take_profit"
    STOP_LOSS = "stop_loss"
    EXIT_SIGNAL = "exit_signal"
    END_OF_DATA = "end_of_data"


@dataclass
class Trade:
    pair: str
    entry_time: str
    entry_price: float
    exit_time: str
    exit_price: float
    quantity: float
    gross_pnl: float
    entry_fee: float
    exit_fee: float
    total_fee: float
    net_pnl: float
    exit_reason: str
    entry_bar_index: int
    exit_bar_index: int
    tp_price: float
    sl_price: float

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


@dataclass
class Metrics:
    pair: str
    trades: int
    winrate: float
    gross_pnl: float
    fees: float
    net_pnl: float
    max_drawdown: float
    avg_trade: float
    profit_factor: float
    total_bars: int
    bars_in_trade: int
    time_in_market: float

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


class Position:
    def __init__(self):
        self.is_open = False
        self.entry_time: Optional[pd.Timestamp] = None
        self.entry_price: float = 0.0
        self.qty: float = 0.0
        self.entry_index: int = -1
        self.tp: float = 0.0
        self.sl: float = 0.0
        self.entry_fee: float = 0.0  # paid at entry

    def open(self, t: pd.Timestamp, price: float, qty: float, idx: int, tp: float, sl: float, entry_fee: float):
        self.is_open = True
        self.entry_time = t
        self.entry_price = price
        self.qty = qty
        self.entry_index = idx
        self.tp = tp
        self.sl = sl
        self.entry_fee = entry_fee

    def close(self):
        self.__init__()


class BacktestRunner:
    def __init__(
        self,
        data_dir: Path,
        cache_dir: Path,
        results_dir: Path,
        notional_usdt: float = 50.0,
        tp_pct: float = 0.004,
        sl_pct: float = 0.003,
        fee_taker: float = 0.00055,
        fee_maker: float = 0.0002,
        starting_equity: float = 0.0,
        use_taker: bool = True,
    ):
        self.data_dir = Path(data_dir)
        self.cache_dir = Path(cache_dir)
        self.results_dir = Path(results_dir)
        self.results_dir.mkdir(parents=True, exist_ok=True)

        self.notional_usdt = float(notional_usdt)
        self.tp_pct = float(tp_pct)
        self.sl_pct = float(sl_pct)
        self.fee_taker = float(fee_taker)
        self.fee_maker = float(fee_maker)
        self.starting_equity = float(starting_equity)
        self.use_taker = bool(use_taker)

        self.report: Dict[str, Any] = {"pairs": {}, "summary": {}}

    def _fee_rate(self) -> float:
        return self.fee_taker if self.use_taker else self.fee_maker

    def calc_fee(self, amount: float) -> float:
        return float(amount) * self._fee_rate()
    def load_indicators(self, pair: str) -> pd.DataFrame:
        """
        Load indicators for `pair`.

        Priority:
          1) In-memory cache: self._ind_cache[pair]
          2) Disk cache via meta.json in cache_dir: {pair}_meta.json
          3) Auto-discover in cache_dir/indicators/ and auto-create meta.json
        """
        # 0) In-memory cache
        if not hasattr(self, "_ind_cache"):
            self._ind_cache = {}
        if pair in self._ind_cache:
            return self._ind_cache[pair]

        meta_path = self.cache_dir / f"{pair}_meta.json"

        # 1) If no meta, try auto-discover in cache_dir/indicators/
        if not meta_path.exists():
            ind_dir = self.cache_dir / "indicators"
            cand_parq = ind_dir / f"{pair}_indicators.parquet"
            cand_npz  = ind_dir / f"{pair}_indicators.npz"

            if cand_parq.exists():
                meta = {"format": "parquet", "path": str(cand_parq)}
                meta_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2), encoding="utf-8")
            elif cand_npz.exists():
                meta = {"format": "npz", "path": str(cand_npz)}
                meta_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2), encoding="utf-8")
            else:
                raise FileNotFoundError(
                    f"{pair}: meta not found: {meta_path} and no discovered indicators in {ind_dir}. "
                    f"Expected {cand_parq} OR {cand_npz}. "
                    f"Create indicator cache first, or place the file in cache/indicators/."
                )

        # 2) Load using meta.json
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
        fmt = (meta.get("format") or "").lower()
        p_override = meta.get("path")

        if fmt == "parquet":
            p = Path(p_override) if p_override else (self.cache_dir / f"{pair}_indicators.parquet")
            if not p.exists():
                raise FileNotFoundError(f"{pair}: parquet cache not found: {p}")
            df = pd.read_parquet(p)
            self._ind_cache[pair] = df
            return df

        if fmt == "npz":
            p = Path(p_override) if p_override else (self.cache_dir / f"{pair}_indicators.npz")
            if not p.exists():
                raise FileNotFoundError(f"{pair}: npz cache not found: {p}")
            z = np.load(p, allow_pickle=False)

            # Our cache uses timestamp_ns (int64 ns, utc)
            if "timestamp_ns" in z.files:
                ts = pd.to_datetime(z["timestamp_ns"].astype("int64"), utc=True)
                out = pd.DataFrame({"timestamp": ts})
            elif "timestamp" in z.files:
                out = pd.DataFrame({"timestamp": pd.to_datetime(z["timestamp"], utc=True, errors="coerce")})
            else:
                raise ValueError(f"{pair}: NPZ missing timestamp key (expected timestamp_ns)")

            # Attach all other numeric arrays as columns (except timestamp keys)
            for k in z.files:
                if k in ("timestamp", "timestamp_ns"):
                    continue
                out[k] = z[k]

            self._ind_cache[pair] = out
            return out

        raise ValueError(f"{pair}: unknown cache format in meta: {fmt!r} (meta={meta})")    def validate_alignment(ohlc: pd.DataFrame, ind: pd.DataFrame, pair: str) -> None:
        if len(ohlc) != len(ind):
            raise ValueError(f"{pair}: length mismatch ohlc={len(ohlc)} ind={len(ind)}")
        if "timestamp" not in ohlc.columns or "timestamp" not in ind.columns:
            raise ValueError(f"{pair}: missing timestamp column")
        if not np.array_equal(ohlc["timestamp"].to_numpy(), ind["timestamp"].to_numpy()):
            # show first mismatch
            a = ohlc["timestamp"].to_numpy()
            b = ind["timestamp"].to_numpy()
            idx = int(np.where(a != b)[0][0])
            raise ValueError(f"{pair}: timestamp mismatch at index {idx}: ohlc={a[idx]} ind={b[idx]}")

    @staticmethod
    def entry_signal(row: pd.Series) -> bool:
        # ENTRY:
        # ema_9 > ema_21
        # rsi_14 < 35
        # close < bb_middle
        ema9 = row["ema_9"]
        ema21 = row["ema_21"]
        rsi = row["rsi_14"]
        close = row["close"]
        bbm = row["bb_middle"]

        if np.isnan(ema9) or np.isnan(ema21) or np.isnan(rsi) or np.isnan(close) or np.isnan(bbm):
            return False
        return (ema9 > ema21) and (rsi < 35.0) and (close < bbm)

    @staticmethod
    def exit_signal(row: pd.Series) -> bool:
        # EXIT: ema_9 < ema_21
        ema9 = row["ema_9"]
        ema21 = row["ema_21"]
        if np.isnan(ema9) or np.isnan(ema21):
            return False
        return (ema9 < ema21)

    def run_pair_fast(self, pair: str, ohlc: pd.DataFrame) -> Tuple[List[Trade], Metrics, pd.Series, Dict[str, Any]]:
        """Fast path: avoids pandas iloc/Series in hot loop.
        Enabled by env FR_FAST=1.
        Optional dev/profiling: FR_TAIL_ALIGN=1 to tail-align indicators if ohlc is trimmed.
        """
        ind = self.load_indicators(pair)

        if len(ohlc) != len(ind) and os.getenv("FR_TAIL_ALIGN","0") == "1":
            if len(ohlc) < len(ind):
                ind_tail = ind.iloc[-len(ohlc):].reset_index(drop=True)
                if ("timestamp" in ohlc.columns) and ("timestamp" in ind_tail.columns):
                    if (ohlc["timestamp"].to_numpy() == ind_tail["timestamp"].to_numpy()).all():
                        ind = ind_tail

        self.validate_alignment(ohlc, ind, pair)

        ts = ohlc["timestamp"].to_numpy()
        o = ohlc["open"].to_numpy(dtype=np.float64)
        h = ohlc["high"].to_numpy(dtype=np.float64)
        l = ohlc["low"].to_numpy(dtype=np.float64)
        c = ohlc["close"].to_numpy(dtype=np.float64)

        rsi = ind["rsi_14"].to_numpy(dtype=np.float64)
        ema9 = ind["ema_9"].to_numpy(dtype=np.float64)
        ema21 = ind["ema_21"].to_numpy(dtype=np.float64)
        bbm = ind["bb_middle"].to_numpy(dtype=np.float64)

        pos = Position()
        trades: List[Trade] = []

        equity = float(self.starting_equity)
        eq_list = []
        bars_in_trade = 0
        total_bars = int(len(c))
        fee_rate = self._fee_rate()

        def isnan(x: float) -> bool:
            return x != x

        for i in range(total_bars - 1):
            eq_list.append(equity)

            if pos.is_open:
                bars_in_trade += 1
                hit_sl = (pos.sl > 0.0 and l[i] <= pos.sl)
                hit_tp = (pos.tp > 0.0 and h[i] >= pos.tp)

                ex = False
                e9 = ema9[i]; e21 = ema21[i]
                if (not isnan(e9)) and (not isnan(e21)):
                    ex = (e9 < e21)

                if hit_sl or hit_tp or ex:
                    reason = ExitReason.STOP_LOSS if hit_sl else (ExitReason.TAKE_PROFIT if hit_tp else ExitReason.EXIT_SIGNAL)

                    exit_price = float(o[i + 1])
                    exit_time = pd.to_datetime(ts[i + 1], utc=True)

                    entry_value = pos.qty * pos.entry_price
                    exit_value = pos.qty * exit_price

                    gross = exit_value - entry_value
                    exit_fee = float(exit_value) * fee_rate
                    total_fee = pos.entry_fee + exit_fee
                    net = gross - total_fee

                    equity += net

                    trades.append(Trade(
                        pair=pair,
                        entry_time=pd.to_datetime(pos.entry_time, utc=True).isoformat(),
                        entry_price=float(pos.entry_price),
                        exit_time=exit_time.isoformat(),
                        exit_price=float(exit_price),
                        quantity=float(pos.qty),
                        gross_pnl=float(gross),
                        entry_fee=float(pos.entry_fee),
                        exit_fee=float(exit_fee),
                        total_fee=float(total_fee),
                        net_pnl=float(net),
                        exit_reason=str(reason.value),
                        entry_bar_index=int(pos.entry_index),
                        exit_bar_index=int(i + 1),
                        tp_price=float(pos.tp),
                        sl_price=float(pos.sl),
                    ))

                    pos.close()
                    continue

            if not pos.is_open:
                e9 = ema9[i]; e21 = ema21[i]; rr = rsi[i]; cc = c[i]; mid = bbm[i]
                if (not isnan(e9)) and (not isnan(e21)) and (not isnan(rr)) and (not isnan(cc)) and (not isnan(mid)):
                    if (e9 > e21) and (rr < 35.0) and (cc < mid):
                        entry_price = float(o[i + 1])
                        if entry_price > 0.0:
                            entry_time = pd.to_datetime(ts[i + 1], utc=True)
                            qty = float(self.notional_usdt) / entry_price
                            entry_value = qty * entry_price
                            entry_fee = float(entry_value) * fee_rate
                            equity -= entry_fee

                            tp = entry_price * (1.0 + float(self.tp_pct))
                            sl = entry_price * (1.0 - float(self.sl_pct))

                            pos.open(entry_time, entry_price, qty, i + 1, tp, sl, entry_fee)
                            bars_in_trade = 0

        if pos.is_open:
            exit_price = float(c[-1])
            exit_time = pd.to_datetime(ts[-1], utc=True)

            entry_value = pos.qty * pos.entry_price
            exit_value = pos.qty * exit_price

            gross = exit_value - entry_value
            exit_fee = float(exit_value) * fee_rate
            total_fee = pos.entry_fee + exit_fee
            net = gross - total_fee

            equity += net

            trades.append(Trade(
                pair=pair,
                entry_time=pd.to_datetime(pos.entry_time, utc=True).isoformat(),
                entry_price=float(pos.entry_price),
                exit_time=exit_time.isoformat(),
                exit_price=float(exit_price),
                quantity=float(pos.qty),
                gross_pnl=float(gross),
                entry_fee=float(pos.entry_fee),
                exit_fee=float(exit_fee),
                total_fee=float(total_fee),
                net_pnl=float(net),
                exit_reason=str(ExitReason.END_OF_DATA.value),
                entry_bar_index=int(pos.entry_index),
                exit_bar_index=int(total_bars - 1),
                tp_price=float(pos.tp),
                sl_price=float(pos.sl),
            ))
            pos.close()

        eq = pd.Series(eq_list, dtype="float64")


        # metrics (auto-filled; profiling/bench)

        gross_pnl = float(sum([t.gross_pnl for t in trades])) if trades else 0.0

        fees      = float(sum([t.total_fee for t in trades])) if trades else 0.0

        net_pnl   = float(sum([t.net_pnl for t in trades])) if trades else 0.0

        wins      = [t for t in trades if t.net_pnl > 0] if trades else []

        losses    = [t for t in trades if t.net_pnl <= 0] if trades else []

        winrate   = float(len(wins)/len(trades)) if trades else 0.0

        tw = float(sum([t.net_pnl for t in wins])) if wins else 0.0

        tl = float(abs(sum([t.net_pnl for t in losses]))) if losses else 0.0

        profit_factor = float(tw/tl) if tl > 0 else (float('inf') if tw > 0 else 0.0)

        roll_max = eq.cummax()

        dd = (eq - roll_max) / roll_max.replace(0, float('nan'))

        max_dd = float(abs(dd.min())) if len(dd) else 0.0

        avg_trade = float(net_pnl/len(trades)) if trades else 0.0

        tim = (bars_in_trade/total_bars) if total_bars else 0.0

        m = Metrics(pair=pair, trades=int(len(trades)), winrate=winrate, gross_pnl=gross_pnl, fees=fees, net_pnl=net_pnl, max_drawdown=max_dd, avg_trade=avg_trade, profit_factor=profit_factor, total_bars=int(total_bars), bars_in_trade=int(bars_in_trade), time_in_market=tim)



        pair_report = {
            "status": "completed",
            "total_trades": int(len(trades)),
            "total_bars": int(total_bars),
            "bars_in_trade": int(bars_in_trade),
            "time_in_market": (bars_in_trade / total_bars) if total_bars else 0.0,
            "final_equity": float(equity),
            "net_pnl": float(getattr(m, "net_pnl", 0.0)),
            "fee_rate_used": fee_rate,
            "fast_path": True,
        }
        return trades, m, eq, pair_report

    def run_pair(self, pair: str, ohlc: pd.DataFrame) -> Tuple[List[Trade], Metrics, pd.Series, Dict[str, Any]]:
        if os.getenv("FR_FAST","0") == "1":
            return self.run_pair_fast(pair, ohlc)
        ind = self.load_indicators(pair)
        self.validate_alignment(ohlc, ind, pair)

        merged = pd.concat([ohlc, ind.drop(columns=["timestamp"])], axis=1)

        required = ["rsi_14", "ema_9", "ema_21", "ema_50", "ema_200", "macd", "macdsignal", "macdhist", "bb_upper", "bb_middle", "bb_lower"]
        missing = [c for c in required if c not in merged.columns]
        if missing:
            raise ValueError(f"{pair}: missing indicator columns: {missing}")

        pos = Position()
        trades: List[Trade] = []

        equity = float(self.starting_equity)
        equity_curve: List[float] = []
        bars_in_trade = 0
        total_bars = len(merged)

        # Iterate until second last bar because execution uses next bar open
        for i in range(total_bars - 1):
            row = merged.iloc[i]
            nxt = merged.iloc[i + 1]

            equity_curve.append(equity)

            if pos.is_open:
                bars_in_trade += 1

                # TP/SL triggers on current bar high/low, execution at next open
                hit_sl = (pos.sl > 0 and row["low"] <= pos.sl)
                hit_tp = (pos.tp > 0 and row["high"] >= pos.tp)
                hit_exit = self.exit_signal(row)

                if hit_sl or hit_tp or hit_exit:
                    reason = ExitReason.STOP_LOSS if hit_sl else (ExitReason.TAKE_PROFIT if hit_tp else ExitReason.EXIT_SIGNAL)

                    exit_price = float(nxt["open"])
                    exit_time = pd.to_datetime(nxt["timestamp"], utc=True)

                    entry_value = pos.qty * pos.entry_price
                    exit_value = pos.qty * exit_price

                    gross = exit_value - entry_value
                    exit_fee = self.calc_fee(exit_value)
                    total_fee = pos.entry_fee + exit_fee
                    net = gross - total_fee

                    equity += net  # entry fee already paid at entry

                    trades.append(Trade(
                        pair=pair,
                        entry_time=pd.to_datetime(pos.entry_time, utc=True).isoformat(),
                        entry_price=float(pos.entry_price),
                        exit_time=exit_time.isoformat(),
                        exit_price=float(exit_price),
                        quantity=float(pos.qty),
                        gross_pnl=float(gross),
                        entry_fee=float(pos.entry_fee),
                        exit_fee=float(exit_fee),
                        total_fee=float(total_fee),
                        net_pnl=float(net),
                        exit_reason=str(reason.value),
                        entry_bar_index=int(pos.entry_index),
                        exit_bar_index=int(i + 1),
                        tp_price=float(pos.tp),
                        sl_price=float(pos.sl),
                    ))

                    pos.close()
                    continue

            # Entry check when flat
            if not pos.is_open and self.entry_signal(row):
                entry_price = float(nxt["open"])
                entry_time = pd.to_datetime(nxt["timestamp"], utc=True)

                if entry_price <= 0:
                    continue

                qty = self.notional_usdt / entry_price
                entry_value = qty * entry_price

                entry_fee = self.calc_fee(entry_value)
                equity -= entry_fee  # fee paid at entry

                tp = entry_price * (1.0 + self.tp_pct)
                sl = entry_price * (1.0 - self.sl_pct)

                pos.open(entry_time, entry_price, qty, i + 1, tp, sl, entry_fee)

        # Close open pos at end (exit at last close, END_OF_DATA)
        if pos.is_open:
            last = merged.iloc[-1]
            exit_price = float(last["close"])
            exit_time = pd.to_datetime(last["timestamp"], utc=True)

            entry_value = pos.qty * pos.entry_price
            exit_value = pos.qty * exit_price

            gross = exit_value - entry_value
            exit_fee = self.calc_fee(exit_value)
            total_fee = pos.entry_fee + exit_fee
            net = gross - total_fee

            equity += net

            trades.append(Trade(
                pair=pair,
                entry_time=pd.to_datetime(pos.entry_time, utc=True).isoformat(),
                entry_price=float(pos.entry_price),
                exit_time=exit_time.isoformat(),
                exit_price=float(exit_price),
                quantity=float(pos.qty),
                gross_pnl=float(gross),
                entry_fee=float(pos.entry_fee),
                exit_fee=float(exit_fee),
                total_fee=float(total_fee),
                net_pnl=float(net),
                exit_reason=str(ExitReason.END_OF_DATA.value),
                entry_bar_index=int(pos.entry_index),
                exit_bar_index=int(total_bars - 1),
                tp_price=float(pos.tp),
                sl_price=float(pos.sl),
            ))
            pos.close()

        equity_curve.append(equity)

        eq = pd.Series(equity_curve, index=merged["timestamp"].iloc[:len(equity_curve)].to_numpy())

        # Metrics
        if len(trades) == 0:
            m = Metrics(
                pair=pair, trades=0, winrate=0.0, gross_pnl=0.0, fees=0.0, net_pnl=0.0,
                max_drawdown=0.0, avg_trade=0.0, profit_factor=0.0,
                total_bars=total_bars, bars_in_trade=bars_in_trade,
                time_in_market=(bars_in_trade / total_bars) if total_bars else 0.0
            )
        else:
            gross_pnl = float(sum(t.gross_pnl for t in trades))
            fees = float(sum(t.total_fee for t in trades))
            net_pnl = float(sum(t.net_pnl for t in trades))

            wins = [t.net_pnl for t in trades if t.net_pnl > 0]
            losses = [t.net_pnl for t in trades if t.net_pnl <= 0]
            winrate = float(len(wins) / len(trades))

            total_wins = float(sum(wins)) if wins else 0.0
            total_losses = float(abs(sum(losses))) if losses else 0.0
            profit_factor = float(total_wins / total_losses) if total_losses > 0 else float("inf")

            # drawdown on equity curve
            roll_max = eq.cummax()
            dd = (eq - roll_max) / roll_max.replace(0, np.nan)
            max_dd = float(abs(dd.min())) if len(dd) else 0.0

            avg_trade = float(np.mean([t.net_pnl for t in trades]))

            m = Metrics(
                pair=pair, trades=int(len(trades)), winrate=winrate, gross_pnl=gross_pnl, fees=fees, net_pnl=net_pnl,
                max_drawdown=max_dd, avg_trade=avg_trade, profit_factor=profit_factor,
                total_bars=total_bars, bars_in_trade=bars_in_trade,
                time_in_market=(bars_in_trade / total_bars) if total_bars else 0.0
            )

        pair_report = {
            "status": "completed",
            "total_trades": int(len(trades)),
            "total_bars": int(total_bars),
            "bars_in_trade": int(bars_in_trade),
            "time_in_market": (bars_in_trade / total_bars) if total_bars else 0.0,
            "final_equity": float(equity),
            "net_pnl": float(m.net_pnl),
            "fee_rate_used": self._fee_rate(),
        }

        return trades, m, eq, pair_report

    def save_pair_outputs(self, pair: str, trades: List[Trade], eq: pd.Series):
        # trades csv
        trades_path = self.results_dir / f"trades_{pair}.csv"
        tdf = pd.DataFrame([t.to_dict() for t in trades])
        if not tdf.empty:
            tdf.to_csv(trades_path, index=False, encoding="utf-8")

        # equity csv
        eq_path = self.results_dir / f"equity_{pair}.csv"
        eq.to_csv(eq_path, header=["equity"])

    def run_all(self, pairs: Optional[List[str]]) -> Dict[str, Any]:
        t0 = time.time()

        loader = ScalpingDataLoader(self.data_dir)
        data = loader.load_all(pairs)

        completed = 0
        errors = 0
        total_trades = 0
        total_net = 0.0
        total_fees = 0.0

        for pair, ohlc in data.items():
            pt0 = time.time()
            try:
                trades, metrics, eq, pair_report = self.run_pair(pair, ohlc)
                self.save_pair_outputs(pair, trades, eq)

                self.report["pairs"][pair] = pair_report
                self.report["pairs"][pair]["metrics"] = metrics.to_dict()

                completed += 1
                total_trades += len(trades)
                total_net += metrics.net_pnl
                total_fees += metrics.fees

                logger.info(f"{pair}: completed trades={len(trades)} net_pnl={metrics.net_pnl:.4f} time={time.time()-pt0:.2f}s")
            except Exception as e:
                errors += 1
                self.report["pairs"][pair] = {"status": "error", "error": str(e), "timestamp": datetime.now().isoformat()}
                logger.error(f"{pair}: ERROR {e}")

        self.report["summary"] = {
            "total_pairs_processed": int(len(data)),
            "completed": int(completed),
            "errors": int(errors),
            "total_trades": int(total_trades),
            "total_net_pnl": float(total_net),
            "total_fees": float(total_fees),
            "avg_net_pnl_per_pair": float(total_net / completed) if completed else 0.0,
            "total_time_seconds": round(time.time() - t0, 2),
            "strategy_parameters": {
                "notional_usdt": self.notional_usdt,
                "tp_pct": self.tp_pct,
                "sl_pct": self.sl_pct,
                "fee_taker": self.fee_taker,
                "fee_maker": self.fee_maker,
                "starting_equity": self.starting_equity,
                "use_taker": self.use_taker,
            },
            "results_directory": str(self.results_dir),
            "completion_time": datetime.now().isoformat(),
        }

        return self.report


def main() -> int:
    parser = argparse.ArgumentParser(description="Production backtest runner (STRICT, no demo).")
    default_project_dir = Path(r"C:\Users\user\Desktop\Франкинштэйн")
    parser.add_argument("--data_dir", type=str, default=str(default_project_dir / "SCALPING_DATA"))
    parser.add_argument("--cache_dir", type=str, default=str(default_project_dir / "cache" / "indicators"))
    parser.add_argument("--results_dir", type=str, default=str(default_project_dir / "results"))
    parser.add_argument("--pairs", type=str, nargs="+")
    parser.add_argument("--notional_usdt", type=float, default=50.0)
    parser.add_argument("--tp_pct", type=float, default=0.004)
    parser.add_argument("--sl_pct", type=float, default=0.003)
    parser.add_argument("--fee_taker", type=float, default=0.00055)
    parser.add_argument("--fee_maker", type=float, default=0.0002)
    parser.add_argument("--starting_equity", type=float, default=0.0)
    parser.add_argument("--maker", action="store_true", help="Use maker fee instead of taker fee")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--output", type=str, default=None)

    args = parser.parse_args()
    if args.verbose:
        logger.setLevel(logging.DEBUG)

    runner = BacktestRunner(
        data_dir=Path(args.data_dir),
        cache_dir=Path(args.cache_dir),
        results_dir=Path(args.results_dir),
        notional_usdt=args.notional_usdt,
        tp_pct=args.tp_pct,
        sl_pct=args.sl_pct,
        fee_taker=args.fee_taker,
        fee_maker=args.fee_maker,
        starting_equity=args.starting_equity,
        use_taker=(not args.maker),
    )

    report = runner.run_all(args.pairs)
    report_json = json.dumps(report, indent=2, ensure_ascii=False)

    out = Path(args.output) if args.output else Path(args.results_dir) / "backtest_report.json"
    out.write_text(report_json, encoding="utf-8")
    logger.info(f"Report saved to: {out}")

    return 0 if report.get("summary", {}).get("completed", 0) > 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
