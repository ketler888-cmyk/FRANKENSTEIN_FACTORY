import os, json, time, random
from pathlib import Path
import pandas as pd
from backtest_runner import BacktestRunner

def pick_data_dir(root: Path) -> Path:
    p = root / "SCALPING_DATA_PARQUET"
    return p if p.exists() else (root / "SCALPING_DATA")

def load_ohlc(root: Path, pair: str) -> pd.DataFrame:
    d = pick_data_dir(root)
    parq = d / f"{pair}_1m.parquet"
    csvp = d / f"{pair}_1m.csv"
    if parq.exists():
        df = pd.read_parquet(parq)
    elif csvp.exists():
        df = pd.read_csv(csvp)
    else:
        raise FileNotFoundError(f"OHLC not found for {pair}")
    df["timestamp"] = pd.to_datetime(df["timestamp"], errors="coerce", utc=False)
    return df

def unpack_trades(res):
    # run_pair_fast returns tuple: (trades, ...)
    if isinstance(res, tuple) and len(res) >= 1 and isinstance(res[0], list):
        return res[0]
    # fallback
    if isinstance(res, dict):
        v = res.get("trades") or res.get("trades_list") or []
        return v if isinstance(v, list) else []
    return []

def metrics_from_trades(trades, start_eq=100.0):
    cnt = len(trades)
    gross = sum(getattr(t, "gross_pnl", 0.0) for t in trades)
    fees  = sum(getattr(t, "total_fee", 0.0) for t in trades)
    net   = sum(getattr(t, "net_pnl", 0.0) for t in trades)

    # dd in absolute USDT
    eq = start_eq
    peak = start_eq
    max_dd = 0.0
    for t in trades:
        eq += float(getattr(t, "net_pnl", 0.0))
        if eq > peak: peak = eq
        dd = peak - eq
        if dd > max_dd: max_dd = dd

    wins = sum(1 for t in trades if getattr(t, "net_pnl", 0.0) > 0)
    win_rate = (wins / cnt) if cnt else 0.0
    return cnt, gross, fees, net, max_dd, win_rate, eq

def score(cnt, net, fees, max_dd):
    # conservative score: reward net, punish drawdown + churn
    # tweak later; for smoke this is enough
    return (net * 100.0) - (max_dd * 50.0) - (fees * 10.0) - (0.02 * cnt)

def clamp(x, lo, hi): return max(lo, min(hi, x))

def mutate(ind):
    tp, sl = ind["tp"], ind["sl"]
    # gaussian step
    tp += random.gauss(0, 0.0003)
    sl += random.gauss(0, 0.0003)
    tp = clamp(tp, 0.0015, 0.0120)
    sl = clamp(sl, 0.0015, 0.0120)
    return {"tp": tp, "sl": sl}

def crossover(a, b):
    if random.random() < 0.5:
        return {"tp": a["tp"], "sl": b["sl"]}
    return {"tp": b["tp"], "sl": a["sl"]}

def main():
    root = Path(__file__).resolve().parent
    pair = os.getenv("FR_PAIR","SOLUSDT")
    max_bars = int(os.getenv("FR_MAX_BARS","0") or "0")
    notional = float(os.getenv("FR_NOTIONAL","50") or "50")
    start_eq = float(os.getenv("FR_START_EQ","100") or "100")
    seed = int(os.getenv("FR_SEED","42") or "42")

    pop_n = int(os.getenv("FR_POP","24") or "24")
    gens  = int(os.getenv("FR_GENS","20") or "20")
    elite = int(os.getenv("FR_ELITE","6") or "6")

    random.seed(seed)

    ohlc = load_ohlc(root, pair)
    if max_bars>0 and len(ohlc)>max_bars:
        ohlc = ohlc.iloc[-max_bars:].copy()

    out_dir = root / "results_ga" / f"ga_smoke_{time.strftime('%Y%m%d_%H%M%S')}"
    out_dir.mkdir(parents=True, exist_ok=True)
    jsonl = out_dir / "ga_smoke_results.jsonl"
    top10p = out_dir / "ga_smoke_top10.json"

    print(f"[GA] out={out_dir}")
    print(f"[GA] pair={pair} bars={len(ohlc)} notional={notional} pop={pop_n} gens={gens} elite={elite} seed={seed}")

    def eval_ind(ind):
        runner = BacktestRunner(
            data_dir=pick_data_dir(root),
            cache_dir=root/"cache",
            results_dir=root/"results_ga",
            notional_usdt=notional,
            tp_pct=ind["tp"],
            sl_pct=ind["sl"],
            starting_equity=start_eq,
        )
        res = runner.run_pair_fast(pair, ohlc)
        trades = unpack_trades(res)
        cnt, gross, fees, net, max_dd, win_rate, end_eq = metrics_from_trades(trades, start_eq)
        sc = score(cnt, net, fees, max_dd)
        return sc, {"tp":ind["tp"],"sl":ind["sl"],"trades":cnt,"gross":gross,"fees":fees,"net":net,"dd":max_dd,"win_rate":win_rate,"end_eq":end_eq}

    # init pop around known zone
    pop=[]
    for _ in range(pop_n):
        tp = random.uniform(0.0025, 0.0070)
        sl = random.uniform(0.0025, 0.0070)
        pop.append({"tp":tp,"sl":sl})

    best_all=[]
    with open(jsonl,"w",encoding="utf-8") as f:
        for g in range(gens):
            scored=[]
            for ind in pop:
                sc, meta = eval_ind(ind)
                meta["score"]=sc
                meta["gen"]=g
                scored.append((sc, meta))
                f.write(json.dumps(meta,ensure_ascii=False)+"\n")
            scored.sort(key=lambda x: x[0], reverse=True)
            best = scored[0][1]
            print(f"[GA] gen={g} best_score={best['score']:.3f} tp={best['tp']:.6f} sl={best['sl']:.6f} trades={best['trades']} net={best['net']:.6f} fees={best['fees']:.6f} dd={best['dd']:.6f}")

            best_all.extend([m for _,m in scored[:elite]])

            # next pop
            elites = [m for _,m in scored[:elite]]
            next_pop = [{"tp":m["tp"],"sl":m["sl"]} for m in elites]

            while len(next_pop) < pop_n:
                a = random.choice(elites); b = random.choice(elites)
                child = crossover(a,b)
                if random.random() < 0.9:
                    child = mutate(child)
                next_pop.append(child)

            pop = next_pop

    best_all.sort(key=lambda m: m["score"], reverse=True)
    top10 = best_all[:10]
    with open(top10p,"w",encoding="utf-8") as f:
        json.dump(top10, f, ensure_ascii=False, indent=2)

    print(f"[GA] top10_saved={top10p}")
    print("[GA] done")

if __name__=="__main__":
    main()