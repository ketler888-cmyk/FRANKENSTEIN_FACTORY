# --- Franken: force silent subprocess (no extra windows) ---
try:
    import subprocess as _sp
    CREATE_NO_WINDOW = getattr(_sp, "CREATE_NO_WINDOW", 0x08000000)
except Exception:
    CREATE_NO_WINDOW = 0x08000000
# ---------------------------------------------------------
import sys, time, json, subprocess
import os
from pathlib import Path
import os
ROOT = Path(__file__).resolve().parents[1]  # project root

class RunnerBridge:
    """
    GA -> backtest_runner_v3.py
    IMPORTANT: we only pass args that backtest_runner_v3.py already supports.
    Extra GA params are stored into cfg.json for traceability, but NOT passed as CLI flags.
    """
    def __init__(self, out_dir: str = None, python_exe: str = None):
        self.out_dir = str(out_dir) if out_dir else str(ROOT / "results_ga")
        self.python_exe = python_exe or sys.executable
        Path(self.out_dir).mkdir(parents=True, exist_ok=True)

    def _mk_eval_dir(self, pair: str) -> Path:
        # one stable eval dir per pair (no millions of folders)
        d = Path(self.out_dir) / "eval" / pair
        d.mkdir(parents=True, exist_ok=True)

        # cleanup previous run artifacts (keep directory, overwrite files)
        for fn in ("backtest_report.json","cfg.json","stdout.log","stderr.log"):
            try:
                p = d / fn
                if p.exists():
                    p.unlink()
            except Exception:
                pass
    def eval_once(self, pair: str, cfg: dict, timeout_sec: int = 900) -> dict:
        eval_dir = self._mk_eval_dir(pair)
        out_json = eval_dir / "backtest_report.json"

        # persist cfg for audit/debug (contains ALL GA params)
        (eval_dir / "cfg.json").write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")

        bt = ROOT / "backtest_runner_v3.py"
        if not bt.exists():
            raise RuntimeError(f"Missing backtest_runner_v3.py at {bt}")

        # REQUIRED / SUPPORTED args (as per your backtest_runner_v3.py -h output)
        max_bars = int(cfg.get("max_bars", 0) or 0)
        notional = float(cfg.get("notional_usdt", cfg.get("notional", 50.0)))
        entry_variant = int(cfg.get("entry_variant", 0))
        rsi_buy = float(cfg.get("rsi_buy", 35.0))
        use_trend_filter = int(cfg.get("use_trend_filter", 1))
        use_bb_filter = int(cfg.get("use_bb_filter", 1))
        breakout_lookback = int(cfg.get("breakout_lookback", 20))
        breakout_atr_k = float(cfg.get("breakout_atr_k", 0.25))

        cmd = [
            self.python_exe, str(bt),
            "--pairs", pair,
            "--max_bars", str(max_bars),
            "--notional_usdt", str(notional),
            "--entry_variant", str(entry_variant),
            "--rsi_buy", str(rsi_buy),
            "--use_trend_filter", str(use_trend_filter),
            "--use_bb_filter", str(use_bb_filter),
            "--breakout_lookback", str(breakout_lookback),
            "--breakout_atr_k", str(breakout_atr_k),
            "--output", str(out_json),
            "--no_optimize",
            "--verbose",
        ]

        p = subprocess.run(cmd, cwd=str(ROOT, creationflags=CREATE_NO_WINDOW), capture_output=True, text=True, timeout=timeout_sec)
        (eval_dir / "stdout.txt").write_text(p.stdout or "", encoding="utf-8")
        (eval_dir / "stderr.txt").write_text(p.stderr or "", encoding="utf-8")

        if not out_json.exists():
            raise RuntimeError("Backtest did not produce output json. Check stdout/stderr in eval_dir.")

        rep = json.loads(out_json.read_text(encoding="utf-8"))
        rep["_eval_dir"] = str(eval_dir)
        rep["_returncode"] = int(p.returncode)
        return rep