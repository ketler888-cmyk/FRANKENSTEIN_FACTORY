import os
import json
import time
from typing import Dict, Any, Optional

class GenePoolWriter:
    """
    Пишем best candidates в gene_pool\best_<pair>.jsonl и gene_pool\best_overall.jsonl
    """
    def __init__(self, pool_dir: str = "gene_pool"):
        self.pool_dir = pool_dir
        os.makedirs(self.pool_dir, exist_ok=True)

    def push(self, pair: str, params: Dict[str, Any], metrics: Dict[str, Any],
             fitness: float, generation: int, run_id: str) -> None:
        rec = {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "pair": pair,
            "run_id": run_id,
            "generation": int(generation),
            "fitness": float(fitness),
            "params": params,
            "metrics": metrics
        }

        # pair file
        pf = os.path.join(self.pool_dir, f"best_{pair}.jsonl")
        with open(pf, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")

        # overall file
        of = os.path.join(self.pool_dir, "best_overall.jsonl")
        with open(of, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
