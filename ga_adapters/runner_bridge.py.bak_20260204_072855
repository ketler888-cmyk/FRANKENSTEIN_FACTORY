import os
import sys
import json
import time
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

class RunnerBridge:
    """
    Single contract for GA <-> backtest_runner_v3.py

    backtest_runner_v3.py MUST accept:
      --pairs <PAIR>
      --params <params.json>
      --output <dir>
      --max_bars <int>   (optional)
    and must write <output>/backtest_report.json (and optionally stdout/stderr captured here)
    """

    def __init__(self, out_dir: str = None, python_exe: str = None):
        self.out_dir = out_dir
        self.python_exe = python_exe or sys.executable

    def _mk_eval_dir(self, base_out: Path, pair: str) -> Path:
        ts = time.strftime("%Y%m%d_%H%M%S")
        d = base_out / f"ga_eval_{pair}_{ts}"
        d.mkdir(parents=True, exist_ok=True)
        return d

    def eval_once(self, pair: str, params: dict, timeout_sec: int = 600) -> dict:
        base_out = Path(self.out_dir) if self.out_dir else (ROOT / "results_ga")
        base_out.mkdir(parents=True, exist_ok=True)

        eval_dir = self._mk_eval_dir(base_out, pair)
        params_path = eval_dir / "params.json"
        params_path.write_text(json.dumps(params, ensure_ascii=False, indent=2), encoding="utf-8")

        bt = ROOT / "backtest_runner_v3.py"
        if not bt.exists():
            raise RuntimeError(f"Missing backtest_runner_v3.py at {bt}")

        cmd = [self.python_exe, str(bt), "--pairs", pair, "--params", str(params_path), "--output", str(eval_dir)]

        # max_bars can come from params (preferred) or env FRANK_MAX_BARS
        max_bars = params.get("max_bars", None)
        if max_bars is None:
            mb = os.environ.get("FRANK_MAX_BARS", "").strip()
            if mb.isdigit():
                max_bars = int(mb)

        if isinstance(max_bars, int) and max_bars > 0:
            cmd += ["--max_bars", str(max_bars)]

        # run
        p = subprocess.run(cmd, cwd=str(ROOT), capture_output=True, text=True, timeout=timeout_sec)

        # save stdout/stderr for debugging
        (eval_dir / "stdout.txt").write_text(p.stdout or "", encoding="utf-8", errors="replace")
        (eval_dir / "stderr.txt").write_text(p.stderr or "", encoding="utf-8", errors="replace")

        if p.returncode != 0:
            raise RuntimeError(
                f"Backtest failed (code={p.returncode}). See:\n  {eval_dir / 'stderr.txt'}\n  {eval_dir / 'stdout.txt'}"
            )

        rep = eval_dir / "backtest_report.json"
        if not rep.exists():
            raise RuntimeError(f"Missing backtest_report.json: {rep}")

        try:
            return json.loads(rep.read_text(encoding="utf-8"))
        except Exception:
            # still return path info even if json parse fails
            raise RuntimeError(f"Could not parse backtest_report.json: {rep}")