from __future__ import annotations
# === FRANKEN_BRIDGE_NORMALIZE_PAIR ===
def _normalize_pair(pair: str) -> str:
    if pair is None:
        return pair
    p = str(pair).strip().upper()
    p = p.replace("/", "").replace("-", "").replace("_", "")
    if p.startswith("XBT"):
        p = "BTC" + p[3:]
    return p

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Optional, Tuple

from .contract import normalize_pair, load_factory_config, enforce_tp_sl_corridor, env_utf8

# Windows no-window
try:
    CREATE_NO_WINDOW = getattr(subprocess, "CREATE_NO_WINDOW", 0x08000000)
except Exception:
    CREATE_NO_WINDOW = 0x08000000

# UTF-8 safety
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="backslashreplace")
    sys.stderr.reconfigure(encoding="utf-8", errors="backslashreplace")
except Exception:
    pass

@dataclass
class RunResult:
    ok: bool
    report_path: str
    stdout_path: str
    stderr_path: str
    elapsed_sec: float
    meta: Dict[str, Any]

class RunnerBridge:
    """
    Compatibility bridge for factory_ga.py and ga_run.py.
    Provides callable methods: eval_once / run_backtest / run / __call__.
    Runs backtest_runner_v3.py as subprocess and parses output JSON report.
    """

    def __init__(
        self,
        starting_equity: float = 500.0,
        train_ratio: float = 0.7,
        config_path: str = "configs/default_config.json",
        out_dir: Optional[str] = None,
        python_exe: Optional[str] = None,
        root: Optional[str] = None,
        bars: Optional[int] = None,
        max_bars: Optional[int] = None,
        **kwargs: Any,
    ):
        self.starting_equity = float(starting_equity)
        self.train_ratio = float(train_ratio)
        self.config_path = str(config_path)
        self.root = Path(root).resolve() if root else Path(__file__).resolve().parents[1]
        self.factory_cfg = load_factory_config(self.root)
        self.max_bars_default = int(max_bars if max_bars is not None else (bars if bars is not None else 0))
        self.out_dir = Path(out_dir).resolve() if out_dir else None

        # python exe
        if python_exe:
            self.python_exe = str(python_exe)
        else:
            venv = self.root / ".venv" / "Scripts" / "python.exe"
            self.python_exe = str(venv) if venv.exists() else "python"

        self.bt_script = self.root / "backtest_runner_v3.py"

    # ---- public API used by callers ----
    def eval_once(self, *args: Any, **kwargs: Any) -> Dict[str, Any]:
        """
        Accepts a huge variety of calling conventions:
          eval_once(pair, params)
          eval_once(cfg_dict)
          eval_once(pair="BTCUSDT", cfg=..., bars=..., timeout_sec=..., notional_usdt=...)
        Returns metrics dict (parsed from backtest_report.json), with _bridge_meta.
        """
        pair, params, bars, timeout, notional = self._parse_call(args, kwargs)
        return self._run_and_read(pair, params, bars, timeout, notional)

    def run_backtest(self, *args: Any, **kwargs: Any) -> Dict[str, Any]:
        return self.eval_once(*args, **kwargs)

    def run(self, *args: Any, **kwargs: Any) -> Dict[str, Any]:
        return self.eval_once(*args, **kwargs)

    def __call__(self, *args: Any, **kwargs: Any) -> Dict[str, Any]:
        return self.eval_once(*args, **kwargs)

    # ---- internals ----
    def _parse_call(self, args: Tuple[Any, ...], kwargs: Dict[str, Any]) -> Tuple[str, Dict[str, Any], int, int, float]:
        # candidates
        pair = kwargs.get("pair") or kwargs.get("symbol") or kwargs.get("pairs")
        cfg = kwargs.get("cfg") or kwargs.get("config") or kwargs.get("params")

        # positional patterns:
        # (pair, params)
        if len(args) >= 2 and pair is None and isinstance(args[0], (str,)) and isinstance(args[1], dict):
            pair = args[0]
            cfg = args[1]
        # (cfg) only
        if len(args) == 1 and pair is None and isinstance(args[0], dict) and cfg is None:
            cfg = args[0]

        pair_s = normalize_pair(pair) if pair is not None else ""
        params = cfg if isinstance(cfg, dict) else {}
        # corridor enforcement (only if tp/sl keys exist)
        try:
            params = enforce_tp_sl_corridor(params, self.factory_cfg)
        except Exception:
            pass

        bars = kwargs.get("bars")
        if bars is None: bars = kwargs.get("n_bars")
        if bars is None: bars = kwargs.get("max_bars")
        if bars is None: bars = kwargs.get("history_bars")
        try:
            bars_i = int(bars) if bars is not None else int(self.max_bars_default)
        except Exception:
            bars_i = int(self.max_bars_default)

        timeout = kwargs.get("timeout_sec")
        if timeout is None: timeout = kwargs.get("timeout")
        if timeout is None: timeout = (self.factory_cfg.get("ga", {}) or {}).get("timeout_sec", 1800)
        try:
            timeout_i = int(timeout)
        except Exception:
            timeout_i = 1800

        notional = kwargs.get("notional_usdt")
        if notional is None: notional = kwargs.get("notional")
        if notional is None: notional = kwargs.get("usd")
        if notional is None: notional = (self.factory_cfg.get("ga", {}) or {}).get("notional", 8)
        try:
            notional_f = float(notional)
        except Exception:
            notional_f = 8.0

        return pair_s, params, bars_i, timeout_i, notional_f

    def _run_and_read(self, pair: str, params: Dict[str, Any], bars: int, timeout_sec: int, notional_usdt: float) -> Dict[str, Any]:
        out = self._resolve_out_dir(pair)
        out.mkdir(parents=True, exist_ok=True)

        stdout_path = out / "stdout.txt"
        stderr_path = out / "stderr.txt"
        report_path = out / "backtest_report.json"

        cmd = self._build_cmd(pair, params, bars, notional_usdt, report_path)

        t0 = time.time()
        ok = False
        err = None

        try:
            proc = subprocess.run(
                cmd,
                cwd=str(self.root),
                env=env_utf8(),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=max(5, int(timeout_sec)),
                creationflags=CREATE_NO_WINDOW,
                text=True,
                encoding="utf-8",
                errors="backslashreplace",
            )
            stdout_path.write_text(proc.stdout or "", encoding="utf-8", errors="backslashreplace")
            stderr_path.write_text(proc.stderr or "", encoding="utf-8", errors="backslashreplace")
            ok = (proc.returncode == 0 and report_path.exists())
            if not ok and report_path.exists():
                # allow partial report even on nonzero exit
                ok = True
        except Exception as e:
            err = repr(e)
            try:
                stderr_path.write_text((stderr_path.read_text(encoding="utf-8", errors="ignore") if stderr_path.exists() else "") + "\n" + err,
                                       encoding="utf-8", errors="backslashreplace")
            except Exception:
                pass

        elapsed = time.time() - t0

        metrics: Dict[str, Any] = {}
        if report_path.exists():
            try:
                metrics = json.loads(report_path.read_text(encoding="utf-8"))
            except Exception:
                try:
                    metrics = json.loads(report_path.read_text(encoding="utf-8-sig"))
                except Exception:
                    metrics = {}

        metrics["_bridge_meta"] = {
            "ok": bool(ok),
            "pair": pair,
            "bars": int(bars),
            "timeout_sec": int(timeout_sec),
            "notional_usdt": float(notional_usdt),
            "cmd": cmd,
            "out_dir": str(out),
            "stdout": str(stdout_path),
            "stderr": str(stderr_path),
            "report": str(report_path),
            "elapsed_sec": float(elapsed),
            "error": err,
        }
        # for downstream fitness bridges expecting "ok"
        metrics["ok"] = bool(ok)
        return metrics

    def _resolve_out_dir(self, pair: str) -> Path:
        if self.out_dir:
            return self.out_dir / ("eval_" + pair) / time.strftime("%Y%m%d_%H%M%S")
        # default: results_ga/eval/<pair>/<timestamp>
        return self.root / "results_ga" / "eval" / (pair or "_NOPAIR") / time.strftime("%Y%m%d_%H%M%S")

    def _build_cmd(self, pair: str, params: Dict[str, Any], bars: int, notional_usdt: float, report_path: Path) -> list:
        cmd = [self.python_exe, str(self.bt_script)]
        # core backtest args
        if pair:
            pair = _normalize_pair(pair)
        cmd += ["--pairs", pair]
        cmd += ["--starting_equity", str(self.starting_equity)]
        cmd += ["--train_ratio", str(self.train_ratio)]
        cmd += ["--max_bars", str(int(bars))]
        cmd += ["--notional_usdt", str(float(notional_usdt))]
        cmd += ["--output", str(report_path)]

        # pass-through params as CLI flags if they look like known flags (safe)
        # We only pass primitive types and keys without spaces.
        for k, v in (params or {}).items():
            if k.startswith("_"):
                continue
            if not isinstance(k, str) or not k or " " in k:
                continue
            if isinstance(v, (dict, list, tuple)):
                continue
            # turn key into --key
            flag = "--" + k
            # bool handling: --flag (true) or skip (false)
            if isinstance(v, bool):
                if v:
                    cmd.append(flag)
                continue
            cmd += [flag, str(v)]
        return cmd