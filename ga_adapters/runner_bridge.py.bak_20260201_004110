import os
import json
import time
import subprocess
from pathlib import Path
from typing import Dict, Any, Optional

# Robust project root:
# ga_adapters/runner_bridge.py -> project root is parent of ga_adapters
THIS_FILE = Path(__file__).resolve()
PROJECT_ROOT = THIS_FILE.parent.parent

class RunnerBridge:
    """
    Bridge between GA (DEAP) and backtest_runner_v3.py.

    HARD GUARANTEE:
      - eval_once() NEVER returns empty metrics dict.
      - On ANY error it returns penalty metrics with fitness=-1e9.
      - stdout/stderr are ALWAYS written into results_ga/run_*.
    """

    # error codes
    EC_TIMEOUT = 1
    EC_NONZERO = 2
    EC_NO_REPORT = 3
    EC_BAD_JSON = 4
    EC_METRICS_NOT_DICT = 5
    EC_EMPTY_AFTER_PARSE = 6
    EC_UNKNOWN = 9

    def __init__(self, starting_equity: float = 500.0, train_ratio: float = 0.7, timeout_sec: Optional[int] = 1800):
        self.starting_equity = float(starting_equity)
        self.train_ratio = float(train_ratio)
        self.timeout_sec = None if timeout_sec is None else int(timeout_sec)

        self.project_dir = PROJECT_ROOT
        self.backtest_py = self.project_dir / "backtest_runner_v3.py"
        if not self.backtest_py.exists():
            raise FileNotFoundError(f"backtest_runner_v3.py not found at {self.backtest_py}")

        self.results_root = self.project_dir / "results_ga"
        self.results_root.mkdir(parents=True, exist_ok=True)

        self._supports_max_bars = None

    def _detect_max_bars_support(self) -> bool:
        if self._supports_max_bars is not None:
            return self._supports_max_bars
        try:
            r = subprocess.run(
                ["python", str(self.backtest_py), "--help"],
                cwd=str(self.project_dir),
                capture_output=True,
                text=True,
                timeout=20
            )
            txt = (r.stdout or "") + "\n" + (r.stderr or "")
            self._supports_max_bars = ("--max_bars" in txt)
        except Exception:
            self._supports_max_bars = False
        return self._supports_max_bars

    def _write_params_json(self, out_dir: Path, params: Dict[str, Any]) -> None:
        p = out_dir / "params.json"
        with open(p, "w", encoding="utf-8") as f:
            json.dump(params, f, ensure_ascii=False, indent=2)

    def _write_text(self, path: Path, text: str) -> None:
        try:
            path.write_text(text or "", encoding="utf-8", errors="replace")
        except Exception:
            try:
                with open(str(path), "wb") as f:
                    f.write((text or "").encode("utf-8", errors="replace"))
            except Exception:
                pass

    def _penalty(self, error_code: int) -> Dict[str, float]:
        return {
            "profit": -1e9,
            "drawdown": 0.0,
            "win_rate": 0.0,
            "profit_factor": 0.0,
            "fitness": -1e9,
            "error_code": float(error_code),
        }

    def eval_once(self, pairs_csv: str, params: Dict[str, Any]) -> Dict[str, float]:
        run_id = time.strftime("%Y%m%d_%H%M%S")
        out_dir = self.results_root / f"run_{run_id}_{os.getpid()}"
        i = 0
        while out_dir.exists():
            i += 1
            out_dir = self.results_root / f"run_{run_id}_{os.getpid()}_{i}"
        out_dir.mkdir(parents=True, exist_ok=True)

        self._write_params_json(out_dir, params)
        report_path = out_dir / "backtest_report.json"

        cmd = [
            "python", str(self.backtest_py),
            "--pairs", pairs_csv,
            "--starting_equity", str(self.starting_equity),
            "--train_ratio", str(self.train_ratio),
            "--output", str(report_path)
        ]

        max_bars = os.environ.get("FRANK_MAX_BARS", "").strip()
        if max_bars and max_bars.isdigit() and self._detect_max_bars_support():
            cmd += ["--max_bars", max_bars]

        try:
            r = subprocess.run(
                cmd,
                cwd=str(self.project_dir),
                capture_output=True,
                text=True,
                timeout=self.timeout_sec
            )
        except subprocess.TimeoutExpired:
            self._write_text(out_dir / "stdout.txt", "")
            self._write_text(out_dir / "stderr.txt", "TIMEOUT\n")
            return self._penalty(self.EC_TIMEOUT)
        except Exception as e:
            self._write_text(out_dir / "stdout.txt", "")
            self._write_text(out_dir / "stderr.txt", f"SUBPROCESS_ERROR: {e}\n")
            return self._penalty(self.EC_UNKNOWN)

        self._write_text(out_dir / "stdout.txt", r.stdout or "")
        self._write_text(out_dir / "stderr.txt", r.stderr or "")

        if r.returncode != 0:
            return self._penalty(self.EC_NONZERO)

        if not report_path.exists():
            return self._penalty(self.EC_NO_REPORT)

        try:
            with open(report_path, "r", encoding="utf-8") as f:
                rep = json.load(f)
        except Exception:
            return self._penalty(self.EC_BAD_JSON)

        m = rep.get("metrics", rep)
        if not isinstance(m, dict):
            return self._penalty(self.EC_METRICS_NOT_DICT)

        out: Dict[str, float] = {}
        for k, v in m.items():
            try:
                out[k] = float(v)
            except Exception:
                pass

        profit = float(out.get("profit", 0.0))
        dd = abs(float(out.get("drawdown", out.get("max_drawdown", 0.0))))
        fitness = float(out.get("fitness", profit - dd * 0.5))

        out["profit"] = profit
        out["drawdown"] = dd
        out["fitness"] = fitness
        out.setdefault("error_code", 0.0)

        if len(out) == 0:
            return self._penalty(self.EC_EMPTY_AFTER_PARSE)

        return out