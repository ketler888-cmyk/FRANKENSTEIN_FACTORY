import sys, time, json, subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

class RunnerBridge:
    """
    Contract: GA -> backtest_runner_v3.py via CLI args (NO --params).
    backtest_runner_v3.py args (present in your codepack):
      --pairs <PAIR...>
      --max_bars <int>
      --notional_usdt <float>
      --entry_variant <0|1|2>
      --rsi_buy <float>
      --use_trend_filter <0|1>
      --use_bb_filter <0|1>
      --breakout_lookback <int>
      --breakout_atr_k <float>
      --no_optimize (for deterministic / faster checks)
      --output <file.json>
    """

    def __init__(self, out_dir: str = None, python_exe: str = None):
        self.out_dir = str(out_dir) if out_dir else str(ROOT / "results_ga")
        self.python_exe = python_exe or sys.executable
        Path(self.out_dir).mkdir(parents=True, exist_ok=True)

    def _mk_eval_dir(self, pair: str) -> Path:
        ts = time.strftime("%Y%m%d_%H%M%S")
        d = Path(self.out_dir) / f"ga_eval_{pair}_{ts}"
        d.mkdir(parents=True, exist_ok=True)
        return d

    def eval_once(self, pair: str, cfg: dict, timeout_sec: int = 900) -> dict:
        eval_dir = self._mk_eval_dir(pair)
        out_json = eval_dir / "backtest_report.json"

        # persist cfg for traceability
        (eval_dir / "cfg.json").write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")

        bt = ROOT / "backtest_runner_v3.py"
        if not bt.exists():
            raise RuntimeError(f"Missing backtest_runner_v3.py at {bt}")

        # defaults aligned to backtest_runner_v3.py
        max_bars = int(cfg.get("max_bars", 0) or 0)
        notional = float(cfg.get("notional_usdt", cfg.get("notional", 50.0)))
        entry_variant = int(cfg.get("entry_variant", 0))
        rsi_buy = float(cfg.get("rsi_buy", 35.0))
        use_trend_filter = int(cfg.get("use_trend_filter", 1))
        use_bb_filter = int(cfg.get("use_bb_filter", 1))
        breakout_lookback = int(cfg.get("breakout_lookback", 20))
        breakout_atr_k = float(cfg.get("breakout_atr_k", 0.25))
        no_optimize = bool(cfg.get("no_optimize", True))

        cmd = [
            self.python_exe, str(bt),
            "--pairs", pair,
            "--max_bars", str(max_bars),
            "--notional_usdt", str(notional),
            "--entry_variant", str(entry_variant),
            "--rsi_buy", str(rsi_buy),
            "--use_trend_filter", str(use_trend_filter),
            "--use_bb_filter", str(use_bb_filter),
            "--breakout_lookback", str(breakout_lookback),
            "--breakout_atr_k", str(breakout_atr_k),
            "--output", str(out_json),
        ]
        if no_optimize:
            cmd.append("--no_optimize")

        p = subprocess.run(cmd, cwd=str(ROOT), capture_output=True, text=True, timeout=timeout_sec)

        (eval_dir / "stdout.txt").write_text(p.stdout or "", encoding="utf-8", errors="replace")
        (eval_dir / "stderr.txt").write_text(p.stderr or "", encoding="utf-8", errors="replace")

        if p.returncode != 0:
            raise RuntimeError(
                f"Backtest failed (code={p.returncode}). See:\n  {eval_dir/'stderr.txt'}\n  {eval_dir/'stdout.txt'}"
            )

        if not out_json.exists():
            raise RuntimeError(f"Missing report file: {out_json}")

        return json.loads(out_json.read_text(encoding="utf-8"))