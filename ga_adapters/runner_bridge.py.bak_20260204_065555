import json
import os
import sys
import time
import subprocess
from pathlib import Path

class RunnerBridge:
    """
    Runs backtest_runner.py as a subprocess and returns backtest_report.json as dict.
    Key fixes:
      - uses sys.executable (venv python)
      - targets backtest_runner.py (supports --tp_pct/--sl_pct/--results_dir/--output)
      - sane default timeout
    """
    def __init__(self, out_dir=None, root_dir=None, results_root=None, timeout_sec: int = 300, quiet: bool = True):
        self.out_dir = out_dir

        self.root_dir = Path(root_dir) if root_dir else Path(__file__).resolve().parent.parent
        self.results_root = Path(results_root) if results_root else (self.root_dir / "results_ga")
        self.timeout_sec = int(timeout_sec)
        self.quiet = bool(quiet)

        # Prefer backtest_runner.py (GA expects tp/sl knobs)
        cand = self.root_dir / "backtest_runner.py"
        if not cand.exists():
            # fallback only if project does not have it
            cand = self.root_dir / "backtest_runner_v3.py"
        if not cand.exists():
            raise FileNotFoundError(f"Backtest runner not found in project root: {self.root_dir}")

        self.target_script = cand

    def eval_once(self, pair: str, params: dict) -> dict:
        pair = str(pair).strip().upper()
        if not pair:
            raise ValueError("pair is empty")

        # Ensure results directory exists
        run_id = time.strftime("%Y%m%d_%H%M%S")
        out_dir = self.results_root / f"ga_eval_{pair}_{run_id}"
        out_dir.mkdir(parents=True, exist_ok=True)

        # Write params snapshot for traceability
        (out_dir / "params.json").write_text(json.dumps(params, ensure_ascii=False, indent=2), encoding="utf-8")

        report_path = out_dir / "backtest_report.json"

        # Params expected by GA (tp/sl as fractions, e.g. 0.004)
        tp = float(params.get("tp", 0.004))
        sl = float(params.get("sl", 0.003))
        notional = float(params.get("notional", 50.0))

        cmd = [
            sys.executable,
            str(self.target_script),
            "--pairs", pair,
            "--notional_usdt", str(notional),
            "--tp_pct", str(tp),
            "--sl_pct", str(sl),
            "--results_dir", str(out_dir),
            "--output", str(report_path),
        ]

        p = subprocess.run(
            cmd,
            cwd=str(self.root_dir),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=self.timeout_sec,
        )

        if p.returncode != 0:
            # keep stderr/stdout for debugging
            (out_dir / "stderr.txt").write_text(p.stderr or "", encoding="utf-8", errors="ignore")
            (out_dir / "stdout.txt").write_text(p.stdout or "", encoding="utf-8", errors="ignore")
            raise RuntimeError(
                f"Backtest failed (code={p.returncode}). See:\n"
                f"  {out_dir / 'stderr.txt'}\n"
                f"  {out_dir / 'stdout.txt'}"
            )

        if not report_path.exists():
            (out_dir / "stderr.txt").write_text(p.stderr or "", encoding="utf-8", errors="ignore")
            (out_dir / "stdout.txt").write_text(p.stdout or "", encoding="utf-8", errors="ignore")
            raise RuntimeError(f"Report not created: {report_path}")

        return json.loads(report_path.read_text(encoding="utf-8"))