import os
import json
import time
import subprocess
from pathlib import Path
from typing import Dict, Any, List, Optional

ROOT = Path(__file__).resolve().parents[1]

class RunnerBridge:
    """
    Minimal, safe bridge:
      - Does NOT instantiate BacktestRunnerV3 (constructor interface is unknown / unstable).
      - Calls backtest_runner_v3.py the same way the user already runs it.
      - Reads metrics from results/backtest_report.json.
    """

    def __init__(self, starting_equity: float = 500.0, train_ratio: float = 0.7, timeout_sec: float = None):
        self.starting_equity = float(starting_equity)
        self.train_ratio = float(train_ratio)
        self.timeout_sec = None if timeout_sec is None else int(timeout_sec)
        self.project_dir = ROOT
        self.backtest_py = self.project_dir / "backtest_runner_v3.py"
        if not self.backtest_py.exists():
            raise FileNotFoundError(f"backtest_runner_v3.py not found at {self.backtest_py}")

        self.results_root = self.project_dir / "results_ga"
        self.results_root.mkdir(parents=True, exist_ok=True)

    def _write_params_json(self, out_dir: Path, params: Dict[str, Any]) -> Path:
        # We create a params.json for traceability even if backtest_runner_v3 does not consume it yet.
        p = out_dir / "params.json"
        with open(p, "w", encoding="utf-8") as f:
            json.dump(params, f, ensure_ascii=False, indent=2)
        return p

    def eval_once(self, pairs_csv: str, params: Dict[str, Any]) -> Dict[str, float]:
        """
        pairs_csv: like "BTCUSDT" or "BTCUSDT,ETHUSDT"
        returns: metrics dict (may be empty on failure)
        """
        run_id = time.strftime("%Y%m%d_%H%M%S")
        out_dir = self.results_root / f"run_{run_id}_{os.getpid()}"
        out_dir.mkdir(parents=True, exist_ok=True)

        # Keep params recorded for debugging
        self._write_params_json(out_dir, params)

        # IMPORTANT:
        # We DO NOT assume backtest_runner_v3 supports params injection flags.
        # For now we run baseline backtest and rely on GA code to evolve later once param injection is confirmed.
        # This keeps the pipeline alive and allows us to validate end-to-end wiring.
        report_path = out_dir / "backtest_report.json"

        cmd = [
            "python", str(self.backtest_py),
            "--pairs", pairs_csv,
            "--starting_equity", str(self.starting_equity),
            "--train_ratio", str(self.train_ratio),
            "--output", str(report_path)
        ]

        try:
            r = subprocess.run(
                cmd,
                cwd=str(self.project_dir),
                capture_output=True,
                text=True,
                timeout=self.timeout_sec
            )
        except subprocess.TimeoutExpired:
            return {}

        if r.returncode != 0:
            # Write stdout/stderr for post-mortem
            (out_dir / "stdout.txt").write_text(r.stdout or "", encoding="utf-8")
            (out_dir / "stderr.txt").write_text(r.stderr or "", encoding="utf-8")
            return {}

        if not report_path.exists():
            (out_dir / "stdout.txt").write_text(r.stdout or "", encoding="utf-8")
            (out_dir / "stderr.txt").write_text(r.stderr or "", encoding="utf-8")
            return {}

        try:
            with open(report_path, "r", encoding="utf-8") as f:
                rep = json.load(f)
        except Exception:
            return {}

        # Accept both rep["metrics"] and top-level metrics fields
        m = rep.get("metrics", rep)
        if not isinstance(m, dict):
            return {}
        # Ensure float-ish
        out = {}
        for k, v in m.items():
            try:
                out[k] = float(v)
            except Exception:
                pass
        return out