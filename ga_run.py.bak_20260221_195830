from deap import base, creator, tools, algorithms

from ga_adapters.param_bridge import ParamBridge
from ga_adapters.fitness_bridge import FitnessBridge
from ga_adapters.runner_bridge import RunnerBridge
from ga_adapters.gene_pool_writer import GenePoolWriter


def load_cfg(path: str) -> Dict[str, Any]:
    with open(path, "r", encoding="utf-8-sig") as f:
        return json.load(f)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pairs", required=True, help="e.g. BTCUSDT,ETHUSDT")
    ap.add_argument("--config", default=os.path.join("configs", "ga_config.json"))
    ap.add_argument("--generations", type=int, default=None)
    ap.add_argument("--max_bars", type=int, default=0, help="max bars (0=full). Debug: 60000 etc.")
    ap.add_argument("--jobs", type=int, default=1, help="parallel eval workers (1=off)")
    ap.add_argument("--population", type=int, default=None)
    ap.add_argument("--dry-run", action="store_true", help="no real backtest; random metrics")
    args = ap.parse_args()

    cfg = load_cfg(os.path.join(ROOT, args.config))
    cfg_fit = cfg.get("fitness", {})
    cfg_ga  = cfg.get("ga", {})
    cfg_bt  = cfg.get("backtest", {})

    seed = int(cfg_ga.get("seed", 42))
    random.seed(seed)

    pairs = [p.strip() for p in args.pairs.split(",") if p.strip()]
    if not pairs:
        raise SystemExit("No pairs")

    generations = int(args.generations if args.generations is not None else cfg_ga.get("generations", 10))
    population_n = int(args.population if args.population is not None else cfg_ga.get("population", 24))

    # Bridges
    pb = ParamBridge()
    fb = FitnessBridge(cfg_fit)
    gp = GenePoolWriter(pool_dir=os.path.join(ROOT, "gene_pool"))

    starting_equity = float(cfg_bt.get("starting_equity", 500.0))
    train_ratio = float(cfg_bt.get("train_ratio", 0.7))
    rb = RunnerBridge(starting_equity=starting_equity, train_ratio=train_ratio)

    names = pb.names()
    if not names:
        raise SystemExit("Param grid empty")

    # DEAP setup (individual genes are integer indices)
    # NOTE: creator can be defined once per process; guard redefinition
    if not hasattr(creator, "FitnessMax"):
        creator.create("FitnessMax", base.Fitness, weights=(1.0,))
    if not hasattr(creator, "Individual"):
        creator.create("Individual", list, fitness=creator.FitnessMax)

    toolbox = base.Toolbox()

    # each gene is an int index; range 0..len(values)-1
    ranges = [max(1, len(pb.param_grid[k])) for k in names]

    def _rand_gene(i: int) -> int:
        r = ranges[i]
        return random.randrange(0, r)

    def init_individual():
        return creator.Individual([_rand_gene(i) for i in range(len(names))])

    toolbox.register("individual", init_individual)
    toolbox.register("population", tools.initRepeat, list, toolbox.individual)

    # operators
    toolbox.register("mate", tools.cxUniform, indpb=0.5)
    def mut(ind, indpb=0.2):
        for i in range(len(ind)):
            if random.random() < indpb:
                ind[i] = _rand_gene(i)
        return (ind,)
    toolbox.register("mutate", mut, indpb=0.2)
    toolbox.register("select", tools.selTournament, tournsize=int(cfg_ga.get("tournament", 3)))

    # eval
    def eval_ind(individual):
        params = pb.individual_to_params(list(individual))

        if args.dry_run:
            # quick smoke: random but bounded metrics
            import math
            m = {
                "total_return": random.uniform(-0.2, 0.5),
                "max_drawdown": random.uniform(0.02, 0.4),
                "winrate": random.uniform(0.25, 0.75),
                "profit_factor": random.uniform(0.7, 3.0),
                "trades_count": float(random.randint(0, 120))
            }
            fit = fb.calc(m)
            individual._last_metrics = m
            individual._last_params = params
            return (fit,)

        fits = []
        last_m = None
        for pair in pairs:
            m = print("[DEBUG ga_run] → вызов eval_once")`n    print("[DEBUG ga_run] → вызов eval_once")`n    rb.eval_once(pair, params)
            last_m = m
            fits.append(fb.calc(m))

        fit = sum(fits) / len(fits) if fits else -1e18
        individual._last_metrics = last_m or {}
        individual._last_params = params
        return (fit,)

    toolbox.register("evaluate", eval_ind)

    # run
    run_id = time.strftime("%Y%m%d_%H%M%S")
    os.makedirs(os.path.join(ROOT, "results_ga"), exist_ok=True)

    pop = toolbox.population(n=population_n)
    hof = tools.HallOfFame(maxsize=int(cfg_ga.get("elitism", 2)))

    stats = tools.Statistics(lambda ind: ind.fitness.values[0])
    stats.register("avg", lambda xs: sum(xs)/len(xs) if xs else 0.0)
    stats.register("min", min)
    stats.register("max", max)

    cxpb = float(cfg_ga.get("cxpb", 0.8))
    mutpb = float(cfg_ga.get("mutpb", 0.25))

    for gen in range(generations):
        pop, _ = algorithms.eaSimple(pop, toolbox, cxpb=cxpb, mutpb=mutpb, ngen=1,
                                     stats=stats, halloffame=hof, verbose=True)

        best = hof[0]
        best_params = getattr(best, "_last_params", pb.individual_to_params(list(best)))
        best_metrics = getattr(best, "_last_metrics", {})
        best_fit = float(best.fitness.values[0])

        for pair in pairs:
            gp.push(pair=pair, params=best_params, metrics=best_metrics, fitness=best_fit, generation=gen, run_id=run_id)

        with open(os.path.join(ROOT, "results_ga", f"gen_{run_id}_{gen:03d}.json"), "w", encoding="utf-8-sig") as f:
            json.dump({
                "run_id": run_id,
                "generation": gen,
                "best_fitness": best_fit,
                "best_params": best_params,
                "best_metrics": best_metrics
            }, f, ensure_ascii=False, indent=2)

    print("DONE. See gene_pool\\best_*.jsonl and results_ga\\gen_*.json")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Interrupted by user")
        raise



