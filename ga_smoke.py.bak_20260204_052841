import argparse
import json
import random
import time
from pathlib import Path

from ga_adapters.runner_bridge import RunnerBridge

TP_MIN, TP_MAX = 0.0020, 0.0100
SL_MIN, SL_MAX = 0.0015, 0.0080

def clamp(x, a, b):
    return a if x < a else (b if x > b else x)

def score_from_report(rep: dict) -> tuple[float, dict]:
    s = rep.get("summary", {}) if isinstance(rep, dict) else {}
    # be defensive: different reports may have different keys
    net = float(s.get("total_return", 0.0))
    dd  = float(s.get("max_drawdown", 0.0))
    wr  = float(s.get("winrate", 0.0))
    pf  = float(s.get("profit_factor", 0.0))
    tr  = int(s.get("trades_count", s.get("trades", 0) or 0))

    # simple robust score: reward net + pf + winrate, punish dd, require some trades
    sc = (net * 10.0) + (pf * 1.0) + (wr * 2.0) - (dd * 5.0)
    if tr < 5:
        sc -= 5.0

    meta = {"net": net, "dd": dd, "winrate": wr, "pf": pf, "trades": tr}
    return sc, meta

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pair", type=str, default="SOLUSDT")
    ap.add_argument("--population", type=int, default=8)
    ap.add_argument("--generations", type=int, default=3)
    ap.add_argument("--notional", type=float, default=50.0)
    ap.add_argument("--timeout_sec", type=int, default=300)
    ap.add_argument("--seed", type=int, default=42)
    args = ap.parse_args()

    random.seed(args.seed)

    out = Path("results_ga") / f"ga_smoke_{time.strftime('%Y%m%d_%H%M%S')}"
    out.mkdir(parents=True, exist_ok=True)

    print(f"[GA] out={out.resolve()}")
    print(f"[GA] pair={args.pair} pop={args.population} gens={args.generations} seed={args.seed} timeout={args.timeout_sec}s")

    rb = RunnerBridge(timeout_sec=int(args.timeout_sec), quiet=True)

    best = None

    def eval_params(tp, sl):
        params = {"tp": float(tp), "sl": float(sl), "notional": float(args.notional)}
        rep = rb.eval_once(args.pair, params)
        sc, meta = score_from_report(rep)
        return sc, meta, params

    # init pop
    pop = []
    for _ in range(int(args.population)):
        tp = random.uniform(TP_MIN, TP_MAX)
        sl = random.uniform(SL_MIN, SL_MAX)
        pop.append({"tp": tp, "sl": sl})

    for gen in range(int(args.generations)):
        gen_best = None
        for ind in pop:
            sc, meta, params = eval_params(ind["tp"], ind["sl"])
            if (gen_best is None) or (sc > gen_best[0]):
                gen_best = (sc, params, meta)
            if (best is None) or (sc > best[0]):
                best = (sc, params, meta)

        bsc, bparams, bmeta = gen_best
        print(f"[GA] gen={gen} best_score={bsc:.4f} tp={bparams['tp']:.6f} sl={bparams['sl']:.6f} trades={bmeta['trades']} net={bmeta['net']:.6f} dd={bmeta['dd']:.6f}")

        # mutate around gen best
        new_pop = [bparams]
        while len(new_pop) < int(args.population):
            tp = float(bparams["tp"]) * random.uniform(0.85, 1.15)
            sl = float(bparams["sl"]) * random.uniform(0.85, 1.15)
            new_pop.append({"tp": clamp(tp, TP_MIN, TP_MAX), "sl": clamp(sl, SL_MIN, SL_MAX)})
        pop = new_pop

    if best:
        bsc, bparams, bmeta = best
        payload = {
            "best_score": float(bsc),
            "best_params": bparams,
            "best_meta": bmeta,
            "pair": args.pair,
            "population": int(args.population),
            "generations": int(args.generations),
            "seed": int(args.seed),
            "timeout_sec": int(args.timeout_sec),
            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        (out / "best.json").write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"[GA] saved: {(out / 'best.json').resolve()}")

if __name__ == "__main__":
    main()