Set-StrictMode -Off
$ErrorActionPreference = "Stop"

$ROOT = "C:\Users\user\Desktop\Франкинштэйн"
$REPO = "https://github.com/ketler888-cmyk/FRANKENSTEIN_FACTORY.git"
$MSG  = ("sync: " + (Get-Date).ToString("yyyy-MM-dd HH:mm:ss"))

function Info($m){ Write-Host "[INFO] $m" -ForegroundColor Cyan }
function Ok($m){ Write-Host "[OK]   $m" -ForegroundColor Green }
function Warn($m){ Write-Host "[WARN] $m" -ForegroundColor Yellow }
function Fail\(\$m\)\{ Write-Host "\[FAIL\] \$m" -ForegroundColor Red; throw \$m \}
function Safe-GitRmCached([string]$path){
    try{
        # remove from index only, ignore if not tracked / not exists
        $null = (git rm -r --cached --ignore-unmatch -- $path 2>$null)
    }catch{
        # last fallback: do not fail sync
    }
}

if(!(Test-Path -LiteralPath $ROOT)){ Fail "ROOT NOT FOUND: $ROOT" }
Set-Location $ROOT

if(!(Test-Path ".git")){ Info "git init..."; git init | Out-Null }
git checkout -B main | Out-Null

# Remote
git remote remove origin 2>$null | Out-Null
git remote add origin $REPO | Out-Null

# Kill stuck states
$locks = @(".git\rebase-merge",".git\rebase-apply",".git\MERGE_HEAD",".git\index.lock")
foreach($l in $locks){ if(Test-Path $l){ Remove-Item $l -Recurse -Force -ErrorAction SilentlyContinue } }

# Harden .gitignore (NO DATA/CACHE IN GIT)
@"
SCALPING_DATA*/
SCALPING_DATA_PARQUET*/
cache/
logs/
results*/
*.parquet
*.csv
.venv/
__pycache__/
*.log
*.zip
tmp/
temp/
"@ | Set-Content ".gitignore" -Encoding UTF8

# Ensure heavy dirs are NOT tracked (keep files locally)
Safe-GitRmCached "cache"
Safe-GitRmCached "SCALPING_DATA_PARQUET"
Safe-GitRmCached "SCALPING_DATA"

# Delta commit
Info "git add -A"
git add -A | Out-Null
$porc = git status --porcelain
if(-not [string]::IsNullOrWhiteSpace($porc)){
    Info "commit: $MSG"
    git commit -m $MSG | Out-Null
    Ok "commit created"
}else{
    Ok "no changes"
}

# Fetch (ignore harmless stderr noise)
Info "fetch origin..."
try { git fetch origin main --prune 2>$null | Out-Null } catch { }

# Push delta
Info "push (delta)..."
git push -u origin main --force-with-lease | Out-Null
Ok "push OK"

# Verify mirror
$local  = (git rev-parse HEAD).Trim()
$remote = (git rev-parse origin/main).Trim()
if($local -eq $remote){
    Ok "MIRROR OK ✅ Local == origin/main"
}else{
    Warn "MIRROR MISMATCH ⚠️"
    Info "LOCAL : $local"
    Info "REMOTE: $remote"
    Info "diffstat origin/main..HEAD:"
    git diff --stat origin/main..HEAD | Out-Host
    throw "Mirror mismatch"
}

