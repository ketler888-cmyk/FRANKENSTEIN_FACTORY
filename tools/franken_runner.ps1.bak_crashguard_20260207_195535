Set-StrictMode -Off
$ErrorActionPreference = "Stop"

param(
  [string]$Root,
  [string]$PairsCsv,
  [int]$TopN = 100,
  [int]$TopK = 3,
  [int]$KeepErrPerPair = 10,
  [int]$MonRefreshSec = 5
)

function Log([string]$m){ Write-Host ("[{0}] {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $m) }

$tools = Join-Path $Root "tools"
$indexer = Join-Path $tools "fr_index_results.ps1"
$monitor = Join-Path $tools "fr_monitor_top3.ps1"

if(!(Test-Path -LiteralPath $indexer)){ throw "Missing: $indexer" }
if(!(Test-Path -LiteralPath $monitor)){ throw "Missing: $monitor" }

$Pairs = $PairsCsv.Split(",") | ForEach-Object { $_.Trim().ToUpper() } | Where-Object { $_ -match "^[A-Z0-9]+USDT$" }
if($Pairs.Count -ne 5){ throw "Runner expects exactly 5 pairs" }

$env:FR_PAIRS = $PairsCsv

# start monitor window (2nd window)
Start-Process -FilePath powershell.exe -WorkingDirectory $Root -ArgumentList @(
  "-NoProfile","-ExecutionPolicy","Bypass","-File",$monitor,"-Root",$Root,"-Pairs",$PairsCsv,"-RefreshSec",$MonRefreshSec
) -WindowStyle Normal | Out-Null

# index refresh loop in background
$job = Start-Job -Name "FR_INDEX_JOB" -ScriptBlock {
  param($Root,$Pairs,$TopN,$TopK,$KeepErr,$Indexer)
  while($true){
    try { & $Indexer -Root $Root -Pairs $Pairs -TopN $TopN -TopK $TopK -KeepErrPerPair $KeepErr | Out-Null } catch {}
    Start-Sleep -Seconds 10
  }
} -ArgumentList $Root,$Pairs,$TopN,$TopK,$KeepErrPerPair,$indexer

# launch python workers (hidden windows) for ONLY these pairs
$py = "python.exe"
$factory = Join-Path $Root "factory_ga.py"
if(!(Test-Path -LiteralPath $factory)){ throw "factory_ga.py not found: $factory" }

$procs = New-Object System.Collections.ArrayList
foreach($p in $Pairs){
  # pass pair explicitly to avoid any hardcoded defaults inside python
  $proc = Start-Process -FilePath $py -WorkingDirectory $Root -ArgumentList @($factory, "--pair", $p) -WindowStyle Hidden -PassThru
  [void]$procs.Add($proc)
  Log ("STARTED " + $p + " pid=" + $proc.Id)
}

Log "RUNNING. Ctrl+C stops everything."

# Ctrl+C handler
$cancelHandler = [ConsoleCancelEventHandler]{
  param($sender,$e)
  $e.Cancel = $true
  try {
    foreach($pp in $procs){
      try { if($pp -and -not $pp.HasExited){ Stop-Process -Id $pp.Id -Force -ErrorAction SilentlyContinue } } catch {}
    }
  } catch {}
  try { Stop-Job -Name "FR_INDEX_JOB" -Force -ErrorAction SilentlyContinue | Out-Null } catch {}
  Log "STOPPED."
  exit 0
}

[Console]::add_CancelKeyPress($cancelHandler)

# keep alive
while($true){
  Start-Sleep -Seconds 2
}