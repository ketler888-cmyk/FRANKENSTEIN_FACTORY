Set-StrictMode -Off
$ErrorActionPreference = "SilentlyContinue"

# UTF-8 stability
$env:PYTHONUTF8 = "1"
$env:PYTHONIOENCODING = "utf-8"

# SAFE speedups: stop BLAS/NumExpr from spawning 8-32 threads *per process*
# When you run 5 pairs in parallel, this is the #1 причина "тормозит/зависает".
$env:OMP_NUM_THREADS="1"
$env:MKL_NUM_THREADS="1"
$env:OPENBLAS_NUM_THREADS="1"
$env:VECLIB_MAXIMUM_THREADS="1"
$env:NUMEXPR_MAX_THREADS="1"

# Optional: deterministic-ish hashing
$env:PYTHONHASHSEED="0"