Set-StrictMode -Off
$ErrorActionPreference = "Stop"

param(
  [Parameter(Mandatory=$true)][string]$Root,
  [Parameter(Mandatory=$true)][string]$PairsCsv,
  [int]$TopN = 100,
  [int]$TopK = 3,
  [int]$KeepErrPerPair = 10,
  [int]$MonRefreshSec = 5
)

function WriteCrash([string]$title, [object]$err){
  try {
    $desk = [Environment]::GetFolderPath("Desktop")
    $stamp = (Get-Date).ToString("yyyyMMdd_HHmmss")
    $fp = Join-Path $desk ("FRANKEN_CRASH_{0}.txt" -f $stamp)

    $msg = @()
    $msg += ("TITLE: " + $title)
    $msg += ("TIME : " + (Get-Date).ToString("yyyy-MM-dd HH:mm:ss"))
    $msg += ("ROOT : " + $Root)
    $msg += ("PAIRS: " + $PairsCsv)
    $msg += ""
    $msg += "==== ERROR ===="
    $msg += ($err | Out-String)
    $msg += ""
    $msg += "==== STACK ===="
    try { $msg += ($err.ScriptStackTrace | Out-String) } catch {}
    try { $msg += ($global:Error[0] | Format-List * -Force | Out-String) } catch {}
    [System.IO.File]::WriteAllText($fp, ($msg -join "`r`n"), (New-Object System.Text.UTF8Encoding($false)))
    return $fp
  } catch { return $null }
}

function ResolvePython([string]$Root){
  # 1) venv (preferred)
  $cand = Join-Path $Root ".venv\Scripts\python.exe"
  if(Test-Path -LiteralPath $cand){ return $cand }

  # 2) venv alternative
  $cand2 = Join-Path $Root "venv\Scripts\python.exe"
  if(Test-Path -LiteralPath $cand2){ return $cand2 }

  # 3) system python
  try {
    $cmd = Get-Command python.exe -ErrorAction SilentlyContinue
    if($cmd -and $cmd.Source){ return $cmd.Source }
  } catch {}

  # 4) py launcher
  try {
    $cmd2 = Get-Command py.exe -ErrorAction SilentlyContinue
    if($cmd2 -and $cmd2.Source){ return $cmd2.Source } # we will call "py -3" style
  } catch {}

  return $null
}

function StartMonitor([string]$Root,[string[]]$Pairs,[int]$MonRefreshSec){
  $monitor = Join-Path (Join-Path $Root "tools") "fr_monitor_top3.ps1"
  if(Test-Path -LiteralPath $monitor){
    Start-Process -FilePath powershell.exe -WorkingDirectory $Root -ArgumentList @(
      "-NoProfile","-ExecutionPolicy","Bypass","-File",$monitor,"-Root",$Root,"-Pairs",($Pairs -join ","),"-RefreshSec",$MonRefreshSec
    ) -WindowStyle Normal | Out-Null
  }
}

try {
  # normalize pairs
  $Pairs = $PairsCsv.Split(",") | ForEach-Object { $_.Trim().ToUpper() } | Where-Object { $_ -match "^[A-Z0-9]+USDT$" }
  if($Pairs.Count -ne 5){ throw "Runner expects exactly 5 pairs. Got: $($Pairs -join ',')" }

  $env:FR_PAIRS = $PairsCsv

  # start monitor window (2nd window) - non-fatal
  try { StartMonitor -Root $Root -Pairs $Pairs -MonRefreshSec $MonRefreshSec } catch {}

  # index refresh job (non-fatal)
  try {
    $indexer = Join-Path (Join-Path $Root "tools") "fr_index_results.ps1"
    if(Test-Path -LiteralPath $indexer){
      Start-Job -Name "FR_INDEX_JOB" -ScriptBlock {
        param($Root,$Pairs,$TopN,$TopK,$KeepErr,$Indexer)
        while($true){
          try { & $Indexer -Root $Root -Pairs $Pairs -TopN $TopN -TopK $TopK -KeepErrPerPair $KeepErr | Out-Null } catch {}
          Start-Sleep -Seconds 10
        }
      } -ArgumentList $Root,$Pairs,$TopN,$TopK,$KeepErrPerPair,$indexer | Out-Null
    }
  } catch {}

  $factory = Join-Path $Root "factory_ga.py"
  if(!(Test-Path -LiteralPath $factory)){ throw "factory_ga.py not found: $factory" }

  $py = ResolvePython $Root
  if([string]::IsNullOrWhiteSpace($py)){ throw "Python not found. Expected .venv\Scripts\python.exe OR system python.exe/py.exe." }

  $usePyLauncher = $false
  if($py.ToLower().EndsWith("\py.exe")){ $usePyLauncher = $true }

  $procs = New-Object System.Collections.ArrayList

  foreach($p in $Pairs){
    if($usePyLauncher){
      # py.exe
      $proc = Start-Process -FilePath $py -WorkingDirectory $Root -ArgumentList @("-3", $factory, "--pair", $p) -WindowStyle Hidden -PassThru
    } else {
      $proc = Start-Process -FilePath $py -WorkingDirectory $Root -ArgumentList @($factory, "--pair", $p) -WindowStyle Hidden -PassThru
    }
    [void]$procs.Add($proc)
    Write-Host ("[START] {0} pid={1}" -f $p, $proc.Id)
  }

  Write-Host "[RUNNING] Ctrl+C stops everything."

  $cancelHandler = [ConsoleCancelEventHandler]{
    param($sender,$e)
    $e.Cancel = $true
    try {
      foreach($pp in $procs){
        try { if($pp -and -not $pp.HasExited){ Stop-Process -Id $pp.Id -Force -ErrorAction SilentlyContinue } } catch {}
      }
    } catch {}
    try { Stop-Job -Name "FR_INDEX_JOB" -Force -ErrorAction SilentlyContinue | Out-Null } catch {}
    Write-Host "[STOPPED]"
    exit 0
  }
  [Console]::add_CancelKeyPress($cancelHandler)

  while($true){ Start-Sleep -Seconds 2 }

} catch {
  $fp = WriteCrash "franken_runner.ps1 crashed" $_
  if($fp){ Write-Host ("CRASH REPORT -> " + $fp) }
  try { Write-Host $_.Exception.Message } catch {}
  try { Write-Host "Press Enter to close..." ; [void](Read-Host) } catch {}
  exit 1
}