import os
import json
import time
import random
from pathlib import Path

from ga_adapters.runner_bridge import RunnerBridge

def clamp(x, a, b):
    return a if x < a else (b if x > b else x)

def score_metrics(m: dict) -> float:
    # Defensive scoring: reward net & trades, penalize fees & drawdown
    net = float(m.get("net", 0.0))
    fees = float(m.get("fees", 0.0))
    dd = float(m.get("dd", 0.0))
    trades = float(m.get("trades", 0.0))
    # weights chosen to keep it stable even if metrics scale varies
    return (net * 10.0) + (trades * 0.10) - (fees * 2.0) - (dd * 3.0)

def main():
    import argparse
    ap = argparse.ArgumentParser()
    ap.add_argument("--pair", default="SOLUSDT")
    ap.add_argument("--population", type=int, default=12)
    ap.add_argument("--generations", type=int, default=5)
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--max_bars", type=int, default=60000)
    ap.add_argument("--timeout_sec", type=int, default=600)
    ap.add_argument("--starting_equity", type=float, default=500.0)
    ap.add_argument("--train_ratio", type=float, default=0.7)
    args = ap.parse_args()

    random.seed(args.seed)

    out = Path("results_ga") / ("ga_smoke_" + time.strftime("%Y%m%d_%H%M%S"))
    out.mkdir(parents=True, exist_ok=True)

    print(f"[GA] out={out.resolve()}")
    print(f"[GA] pair={args.pair} pop={args.population} gens={args.generations} seed={args.seed} max_bars={args.max_bars} timeout={args.timeout_sec}s")

    # RunnerBridge reads FRANK_MAX_BARS env var
    os.environ["FRANK_MAX_BARS"] = str(int(args.max_bars))

    rb = RunnerBridge(
        starting_equity=float(args.starting_equity),
        train_ratio=float(args.train_ratio),
        timeout_sec=int(args.timeout_sec),
    )

    # Param ranges (safe defaults for smoke)
    TP_MIN, TP_MAX = 0.0010, 0.0100
    SL_MIN, SL_MAX = 0.0010, 0.0100

    best = None  # (score, params, metrics)

    pop = []
    for _ in range(int(args.population)):
        tp = random.uniform(TP_MIN, TP_MAX)
        sl = random.uniform(SL_MIN, SL_MAX)
        pop.append({"tp": tp, "sl": sl})

    for gen in range(int(args.generations)):
        gen_best = None

        for ind in pop:
            params = dict(ind)
            # clamp just in case mutations drift
            params["tp"] = clamp(float(params["tp"]), TP_MIN, TP_MAX)
            params["sl"] = clamp(float(params["sl"]), SL_MIN, SL_MAX)

            m = rb.eval_once(args.pair, params)
            sc = score_metrics(m)

            if (gen_best is None) or (sc > gen_best[0]):
                gen_best = (sc, params, m)

            if (best is None) or (sc > best[0]):
                best = (sc, params, m)

        bsc, bparams, bm = gen_best
        print(f"[GA] gen={gen} best_score={bsc:.6f} tp={bparams['tp']:.6f} sl={bparams['sl']:.6f} trades={bm.get('trades')} net={bm.get('net')} fees={bm.get('fees')} dd={bm.get('dd')}")

        # simple mutate around best
        new_pop = [bparams]
        while len(new_pop) < int(args.population):
            tp = float(bparams["tp"]) * random.uniform(0.85, 1.15)
            sl = float(bparams["sl"]) * random.uniform(0.85, 1.15)
            new_pop.append({"tp": clamp(tp, TP_MIN, TP_MAX), "sl": clamp(sl, SL_MIN, SL_MAX)})
        pop = new_pop

    if best:
        bsc, bparams, bm = best
        payload = {
            "best_score": float(bsc),
            "best_params": bparams,
            "best_metrics": bm,
            "pair": args.pair,
            "population": int(args.population),
            "generations": int(args.generations),
            "seed": int(args.seed),
            "max_bars": int(args.max_bars),
            "timeout_sec": int(args.timeout_sec),
            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        (out / "best.json").write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"[GA] saved: {(out / 'best.json').resolve()}")

if __name__ == "__main__":
    main()