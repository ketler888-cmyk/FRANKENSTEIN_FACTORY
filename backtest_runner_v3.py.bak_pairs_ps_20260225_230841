    def load_ohlc_data(self, pair: str) -> pd.DataFrame:
        loader = ScalpingDataLoader(self.data_dir)
        data = loader.load_all([pair])
        if pair not in data:
            raise ValueError(f"Pair {pair} not found in loaded data")

        df = data[pair].copy()
        required = ['timestamp', 'open', 'high', 'low', 'close', 'volume']
        for c in required:
            if c not in df.columns:
                raise ValueError(f"Required column {c} not found in OHLC data")

        df = df.sort_values('timestamp').reset_index(drop=True)
        # FAST MODE: limit bars (keep alignment)
        if getattr(self, 'max_bars', 0) and len(df) > self.max_bars:
            df = df.tail(self.max_bars).reset_index(drop=True)
        return df

    def load_indicator_data(self, pair: str) -> pd.DataFrame:
        parquet_file = self.cache_dir / f"{pair}_indicators.parquet"
        npz_file = self.cache_dir / f"{pair}_indicators.npz"
        meta_file = self.cache_dir / f"{pair}_meta.json"

        if not meta_file.exists():
            raise FileNotFoundError(f"No cache metadata for {pair}. Run: python indicator_cache.py --force")

        with open(meta_file, 'r', encoding='utf-8') as f:
            meta = json.load(f)

        cache_format = meta.get('format', 'parquet')

        # fallback if meta wrong
        if cache_format == 'parquet' and (not parquet_file.exists()) and npz_file.exists():
            cache_format = 'npz'
        if cache_format == 'npz' and (not npz_file.exists()) and parquet_file.exists():
            cache_format = 'parquet'

        if cache_format == 'parquet' and parquet_file.exists():
            df = pd.read_parquet(parquet_file)
        elif cache_format == 'npz' and npz_file.exists():
            data = np.load(npz_file, allow_pickle=True)
            df_dict = {}
            if 'timestamp_ns' in data:
                df_dict['timestamp'] = pd.to_datetime(data['timestamp_ns'])
            elif 'timestamp' in data:
                df_dict['timestamp'] = data['timestamp']

            cols = meta.get('columns', [])
            for c in cols:
                if c != 'timestamp' and c in data:
                    df_dict[c] = data[c]
            df = pd.DataFrame(df_dict)
        else:
            raise FileNotFoundError(f"No cache file found for {pair}. Run: python indicator_cache.py --force")

        if 'atr_14' not in df.columns:
            raise ValueError(f"ATR(14) not found for {pair}. Run: python indicator_cache.py --force")

        # FAST MODE: limit bars (keep alignment)
        if getattr(self, 'max_bars', 0) and len(df) > self.max_bars:
            df = df.tail(self.max_bars).reset_index(drop=True)
        return df

    def validate_data_alignment(self, ohlc_df: pd.DataFrame, ind_df: pd.DataFrame, pair: str) -> bool:
        if len(ohlc_df) != len(ind_df):
            logger.error(f"{pair}: Length mismatch OHLC={len(ohlc_df)} ind={len(ind_df)}")
            return False
        if not ohlc_df['timestamp'].equals(ind_df['timestamp']):
            mism = (ohlc_df['timestamp'] != ind_df['timestamp'])
            if mism.any():
                i = int(mism[mism].index[0])
                logger.error(f"{pair}: Timestamp mismatch at {i}: OHLC={ohlc_df['timestamp'].iloc[i]} IND={ind_df['timestamp'].iloc[i]}")
                return False
        for c in ['rsi_14', 'ema_9', 'ema_21', 'bb_middle', 'atr_14']:
            if c not in ind_df.columns:
                logger.error(f"{pair}: Missing indicator {c}")
                return False
        return True

    def split_train_test(self, df: pd.DataFrame) -> Tuple[pd.DataFrame, pd.DataFrame]:
        if self.train_ratio <= 0 or self.train_ratio >= 1:
            raise ValueError("train_ratio must be (0,1)")
        idx = int(len(df) * self.train_ratio)
        return df.iloc[:idx].copy(), df.iloc[idx:].copy()

    def calculate_fee(self, amount_usdt: float, is_entry: bool) -> float:
        if is_entry:
            rate = self.fee_taker
        else:
            rate = self.fee_maker if self.use_maker_exit else self.fee_taker
        return float(amount_usdt) * float(rate)

    def generate_entry_signal(self, row: pd.Series, params: Dict[str, float], atr_median: float = None) -> bool:
        try:
            c1 = (row.get('ema_9', np.nan) > row.get('ema_21', np.nan)) if self.use_trend_filter else True
            c2 = row.get('rsi_14', np.nan) < self.rsi_buy
            c3 = (row.get('close', np.nan) < row.get('bb_middle', np.nan)) if self.use_bb_filter else True
            if pd.isna(c1) or pd.isna(c2) or pd.isna(c3):
                return False
            if atr_median is not None:
                cur_atr = row.get('atr_14', np.nan)
                if pd.isna(cur_atr) or cur_atr < (params['min_atr_multiplier'] * atr_median):
                    return False
            legacy_ok = bool(c1 and c2 and c3)

            # breakout leg (requires precomputed roll_high)
            rh = row.get('roll_high', np.nan)
            close = row.get('close', np.nan)
            atr = row.get('atr_14', np.nan)
            breakout_ok = False
            if not pd.isna(rh) and not pd.isna(close) and not pd.isna(atr):
                breakout_ok = bool(close > (rh + self.breakout_atr_k * atr))

            if self.entry_variant == 0:
                return legacy_ok
            if self.entry_variant == 1:
                return breakout_ok
            # 2 = hybrid
            return bool(legacy_ok or breakout_ok)

        except Exception:
            return False

    def generate_exit_signal(self, row: pd.Series) -> bool:
        try:
            c = row.get('ema_9', np.nan) < row.get('ema_21', np.nan)
            return False if pd.isna(c) else bool(c)
        except Exception:
            return False

    def calculate_tp_sl_prices(self, entry_price: float, quantity: float, atr: float,
                              params: Dict[str, float]) -> Tuple[float, float, float, float]:
        atr_usdt = float(atr) * float(quantity)

        entry_fee = self.calculate_fee(self.notional_usdt, is_entry=True)
        exit_fee = self.calculate_fee(self.notional_usdt, is_entry=False)
        total_cost = entry_fee + exit_fee + self.slip_buffer_usdt

        tp_usdt = max(
            params['tp_min_usdt'],
            total_cost + params['target_profit_min_usdt'] + params['k_tp'] * atr_usdt
        )
        sl_usdt = max(params['sl_min_usdt'], params['k_sl'] * atr_usdt)

        tp_price = float(entry_price) + (tp_usdt / float(quantity))
        sl_price = float(entry_price) - (sl_usdt / float(quantity))

        min_sl_dist = float(entry_price) * 0.0005
        if sl_price > float(entry_price) - min_sl_dist:
            sl_price = float(entry_price) - min_sl_dist
            sl_usdt = (float(entry_price) - sl_price) * float(quantity)

        return tp_price, sl_price, tp_usdt, sl_usdt

    def check_exit_conditions(self, current_bar: pd.Series, next_bar: pd.Series,
                              pos: PositionState) -> Tuple[bool, str, float]:
        pos.increment_hold_time()

        if pos.bars_held >= pos.max_hold_bars:
            return True, ExitReason.TIME_STOP.value, float(next_bar['open'])

        if pos.sl_price > 0 and float(current_bar['low']) <= float(pos.sl_price):
            exit_price = min(float(next_bar['open']), float(pos.sl_price))
            return True, ExitReason.STOP_LOSS.value, exit_price

        if pos.tp_price > 0 and float(current_bar['high']) >= float(pos.tp_price):
            exit_price = min(float(next_bar['open']), float(pos.tp_price))
            return True, ExitReason.TAKE_PROFIT.value, exit_price

        if self.generate_exit_signal(current_bar):
            return True, ExitReason.EXIT_SIGNAL.value, float(next_bar['open'])

        return False, "", 0.0

    def run_backtest_segment(self, df: pd.DataFrame, pair: str, params: Dict[str, float],
                            segment_name: str = "test") -> Tuple[List[Trade], pd.Series, float]:

        atr_median = None
        # ===== DEBUG ENTRY FILTERS (diagnostic only; does NOT change trading logic) =====
        if getattr(self, "debug_signals", False):
            try:
                n = int(len(df))
                if n > 0:
                    trend = (df["ema_9"] > df["ema_21"]) if ("ema_9" in df.columns and "ema_21" in df.columns) else None
                    rsi   = (df["rsi_14"] < self.rsi_buy) if ("rsi_14" in df.columns) else None
                    bb    = (df["close"] < df["bb_middle"]) if ("close" in df.columns and "bb_middle" in df.columns) else None
                    mult  = float(params.get("min_atr_multiplier", 1.0)) if isinstance(params, dict) else 1.0
                    # atr_median Ð¼Ð¾Ð¶ÐµÑ‚ Ð±Ñ‹Ñ‚ÑŒ ÐµÑ‰Ñ‘ None Ð·Ð´ÐµÑÑŒ; Ð±ÐµÑ€Ñ‘Ð¼ Ð»Ð¾ÐºÐ°Ð»ÑŒÐ½Ð¾ Ð¸Ð· df Ð±ÐµÐ·Ð¾Ð¿Ð°ÑÐ½Ð¾
                    local_med = None
                    if "atr_14" in df.columns:
                        try:
                            local_med = float(df["atr_14"].median())
                        except Exception:
                            local_med = None
                    if local_med is not None:
                        atr = (df["atr_14"] >= (local_med * mult))
                    else:
                        atr = None
                    all_ok = None
                    if trend is not None and rsi is not None and bb is not None and atr is not None:
                        all_ok = (trend & rsi & bb & atr)
                    def pct(x):
                        return 100.0 * float(x) / float(n) if n else 0.0
                    logger.info(
                        f"[DEBUG_SIGNALS] bars={n} "
                        + (f"trend={int(trend.sum())}({pct(trend.sum()):.2f}%) " if trend is not None else "trend=NA ")
                        + (f"rsi<{self.rsi_buy:g}={int(rsi.sum())}({pct(rsi.sum()):.2f}%) " if rsi is not None else "rsi<35=NA ")
                        + (f"close<bbmid={int(bb.sum())}({pct(bb.sum()):.2f}%) " if bb is not None else "close<bbmid=NA ")
                        + (f"atr_gate(mult={mult:.3f})={int(atr.sum())}({pct(atr.sum()):.2f}%) " if atr is not None else f"atr_gate(mult={mult:.3f})=NA ")
                        + (f"ALL={int(all_ok.sum())}({pct(all_ok.sum()):.4f}%)" if all_ok is not None else "ALL=NA")
                    )
            except Exception as e:
                try:
                    logger.info(f"[DEBUG_SIGNALS] error: {e}")
                except Exception:
                    pass
        # ============================================================================
        if 'min_atr_multiplier' in params:
            atr_median = float(df['atr_14'].median())

        pos = PositionState()
        trades: List[Trade] = []
        equity_curve: List[float] = []
        equity = float(self.starting_equity)

        bars_in_trade = 0

        bars_total = int(len(df))
        # --- PHASE_UPDATES_V1 ---
        try:
            phase0 = segment_name if segment_name in ('train','test','train_opt') else 'test'
            self._hb.update_pair(pair, phase0, segment_name=segment_name, bar_i=0, bars_total=bars_total, completion_percent=0.0)
            self._hb.update_global(phase0, current_pair=pair, segment_name=segment_name, bar_i=0, bars_total=bars_total, completion_percent=0.0)
        except Exception:
            pass
        # --- PHASE_UPDATES_V1 ---

        for i in range(len(df) - 1):
            cur = df.iloc[i]
            nxt = df.iloc[i + 1]
            equity_curve.append(equity)

            if pos.is_open:
                bars_in_trade += 1
                should_exit, reason, exit_price = self.check_exit_conditions(cur, nxt, pos)
                if should_exit:
                    exit_time = nxt['timestamp']

                    exit_value = pos.quantity * float(exit_price)
                    entry_value = pos.quantity * float(pos.entry_price)
                    gross_pnl = exit_value - entry_value

                    entry_fee = 0.0
                    if not pos.entry_fee_paid:
                        entry_fee = self.calculate_fee(entry_value, is_entry=True)
                        pos.entry_fee_paid = True

                    exit_fee = self.calculate_fee(exit_value, is_entry=False)
                    total_fee = entry_fee + exit_fee
                    net_pnl = gross_pnl - total_fee

                    equity += net_pnl

                    trades.append(Trade(
                        pair=pair,
                        entry_time=pos.entry_time,
                        entry_price=float(pos.entry_price),
                        exit_time=exit_time,
                        exit_price=float(exit_price),
                        quantity=float(pos.quantity),
                        gross_pnl=float(gross_pnl),
                        entry_fee=float(entry_fee),
                        exit_fee=float(exit_fee),
                        total_fee=float(total_fee),
                        net_pnl=float(net_pnl),
                        exit_reason=reason,
                        entry_bar_index=int(pos.entry_bar_index),
                        exit_bar_index=int(i + 1),
                        tp_price=float(pos.tp_price),
                        sl_price=float(pos.sl_price),
                        max_hold_bars=int(pos.max_hold_bars),
                        bars_held=int(pos.bars_held),
                        atr_value=float(pos.atr_value),
                        tp_usdt=float(pos.tp_usdt),
                        sl_usdt=float(pos.sl_usdt)
                    ))

                    pos.close_position()
                    continue

            if not pos.is_open:
                entry_fee_est = self.calculate_fee(self.notional_usdt, is_entry=True)
                if equity >= self.notional_usdt + entry_fee_est:
                    if self.generate_entry_signal(cur, params, atr_median):
                        entry_price = float(nxt['open'])
                        entry_time = nxt['timestamp']
                        qty = float(self.notional_usdt) / entry_price

                        atr_val = cur.get('atr_14', np.nan)
                        if pd.isna(atr_val) or float(atr_val) <= 0:
                            atr_val = 0.001 * entry_price  # fallback
                        atr_val = float(atr_val)

                        tp_price, sl_price, tp_usdt, sl_usdt = self.calculate_tp_sl_prices(
                            entry_price, qty, atr_val, params
                        )

                        pos.open_position(
                            entry_time=entry_time,
                            entry_price=entry_price,
                            quantity=qty,
                            entry_bar_index=i + 1,
                            tp_price=tp_price,
                            sl_price=sl_price,
                            max_hold_bars=params['max_hold_bars'],
                            atr_value=atr_val,
                            tp_usdt=tp_usdt,
                            sl_usdt=sl_usdt
                        )

            # --- SEG_PROGRESS_V1 ---
            if ((i + 1) % 50000 == 0) or (i + 1 == max(1, bars_total - 1)):
                try:
                    comp = ((i + 1) / max(1, (bars_total - 1))) * 100.0
                    phase = segment_name if segment_name in ('train','test','train_opt') else 'test'
                    self._hb.update_pair(
                        pair, phase,
                        segment_name=segment_name,
                        bar_i=int(i + 1),
                        bars_total=int(bars_total),
                        completion_percent=round(float(comp), 2),
                        equity=round(float(equity), 6),
                        open_position=bool(pos.is_open),
                        bars_in_trade=int(bars_in_trade),
                        trades_count=int(len(trades))
                    )
                    self._hb.update_global(
                        phase, current_pair=pair,
                        segment_name=segment_name,
                        bar_i=int(i + 1),
                        bars_total=int(bars_total),
                        completion_percent=round(float(comp), 2),
                        equity=round(float(equity), 6),
                        open_position=bool(pos.is_open),
                        bars_in_trade=int(bars_in_trade),
                        trades_count=int(len(trades))
                    )
                except Exception:
                    pass
            # --- SEG_PROGRESS_V1 ---

        if pos.is_open:
            last = df.iloc[-1]
            exit_price = float(last['close'])
            exit_time = last['timestamp']

            exit_value = pos.quantity * exit_price
            entry_value = pos.quantity * float(pos.entry_price)
            gross_pnl = exit_value - entry_value

            entry_fee = 0.0
            if not pos.entry_fee_paid:
                entry_fee = self.calculate_fee(entry_value, is_entry=True)
            exit_fee = self.calculate_fee(exit_value, is_entry=False)
            total_fee = entry_fee + exit_fee
            net_pnl = gross_pnl - total_fee
            equity += net_pnl

            trades.append(Trade(
                pair=pair,
                entry_time=pos.entry_time,
                entry_price=float(pos.entry_price),
                exit_time=exit_time,
                exit_price=float(exit_price),
                quantity=float(pos.quantity),
                gross_pnl=float(gross_pnl),
                entry_fee=float(entry_fee),
                exit_fee=float(exit_fee),
                total_fee=float(total_fee),
                net_pnl=float(net_pnl),
                exit_reason=ExitReason.END_OF_DATA.value,
                entry_bar_index=int(pos.entry_bar_index),
                exit_bar_index=int(len(df) - 1),
                tp_price=float(pos.tp_price),
                sl_price=float(pos.sl_price),
                max_hold_bars=int(pos.max_hold_bars),
                bars_held=int(pos.bars_held),
                atr_value=float(pos.atr_value),
                tp_usdt=float(pos.tp_usdt),
                sl_usdt=float(pos.sl_usdt)
            ))

        equity_curve.append(equity)
        return trades, pd.Series(equity_curve, index=df.index[:len(equity_curve)]), float(equity)

    def calculate_metrics(self, trades: List[Trade], equity_curve: pd.Series,
                         total_bars: int, bars_in_trade: int,
                         starting_equity: float, final_equity: float,
                         pair: str) -> BacktestMetrics:

        if not trades:
            return BacktestMetrics(
                pair=pair, total_trades=0, winning_trades=0, losing_trades=0, win_rate=0.0,
                gross_pnl=0.0, total_fees=0.0, net_pnl=0.0, max_drawdown=0.0,
                avg_trade_pnl=0.0, profit_factor=0.0, largest_win=0.0, largest_loss=0.0,
                avg_win=0.0, avg_loss=0.0, best_trade=0.0, worst_trade=0.0,
                sharpe_ratio=0.0, sortino_ratio=0.0, total_bars=total_bars,
                bars_in_trade=bars_in_trade, time_in_market=(bars_in_trade / total_bars if total_bars else 0.0),
                final_equity=final_equity, starting_equity=starting_equity
            )

        total_trades = len(trades)
        wins = [t.net_pnl for t in trades if t.net_pnl > 0]
        losses = [t.net_pnl for t in trades if t.net_pnl <= 0]
        win_rate = len(wins) / total_trades if total_trades else 0.0

        gross_pnl = float(sum(t.gross_pnl for t in trades))
        fees = float(sum(t.total_fee for t in trades))
        net_pnl = float(sum(t.net_pnl for t in trades))

        net_pnls = [t.net_pnl for t in trades]
        avg_trade = float(np.mean(net_pnls)) if net_pnls else 0.0

        largest_win = float(max(wins)) if wins else 0.0
        largest_loss = float(min(losses)) if losses else 0.0
        avg_win = float(np.mean(wins)) if wins else 0.0
        avg_loss = float(np.mean(losses)) if losses else 0.0
        best_trade = float(max(net_pnls)) if net_pnls else 0.0
        worst_trade = float(min(net_pnls)) if net_pnls else 0.0

        total_wins = float(sum(wins))
        total_losses = float(abs(sum(losses)))
        profit_factor = (total_wins / total_losses) if total_losses > 0 else float('inf')

        if len(equity_curve) > 0:
            roll_max = equity_curve.expanding().max()
            dd = (equity_curve - roll_max) / roll_max
            max_dd = float(abs(dd.min())) if (not dd.empty and dd.min() < 0) else 0.0
        else:
            max_dd = 0.0

        sharpe = 0.0
        sortino = 0.0
        if len(equity_curve) > 1:
            rets = equity_curve.pct_change().dropna()
            if len(rets) > 1 and rets.std() > 0:
                sharpe = float(rets.mean() / rets.std() * np.sqrt(252 * 24 * 60))
                down = rets[rets < 0]
                if len(down) > 0 and down.std() > 0:
                    sortino = float(rets.mean() / down.std() * np.sqrt(252 * 24 * 60))

        time_in_mkt = (bars_in_trade / total_bars) if total_bars else 0.0

        return BacktestMetrics(
            pair=pair,
            total_trades=total_trades,
            winning_trades=len(wins),
            losing_trades=len(losses),
            win_rate=float(win_rate),
            gross_pnl=gross_pnl,
            total_fees=fees,
            net_pnl=net_pnl,
            max_drawdown=max_dd,
            avg_trade_pnl=avg_trade,
            profit_factor=float(profit_factor),
            largest_win=largest_win,
            largest_loss=largest_loss,
            avg_win=avg_win,
            avg_loss=avg_loss,
            best_trade=best_trade,
            worst_trade=worst_trade,
            sharpe_ratio=sharpe,
            sortino_ratio=sortino,
            total_bars=int(total_bars),
            bars_in_trade=int(bars_in_trade),
            time_in_market=float(time_in_mkt),
            final_equity=float(final_equity),
            starting_equity=float(starting_equity)
        )

    def optimize_parameters(self, train_df: pd.DataFrame, pair: str) -> Dict[str, float]:
        best_params = None
        best_score = -1e18
        param_names = list(self.PARAM_GRID.keys())
        grids = [self.PARAM_GRID[n] for n in param_names]

        total_combos = 1
        for g in grids:
            total_combos *= max(1, len(g))
        tested = 0
        valid_count = 0
        opt_t0 = time.time()
        # --- PHASE_UPDATES_V1 ---
        try:
            self._hb.update_pair(pair, 'optimize', opt_tested=0, opt_total=int(total_combos))
            self._hb.update_global('optimize', current_pair=pair, opt_tested=0, opt_total=int(total_combos))
        except Exception:
            pass
        # --- PHASE_UPDATES_V1 ---

        for vals in itertools.product(*grids):
            params = dict(zip(param_names, vals))
            tested += 1
            try:
                trades, eq, fin = self.run_backtest_segment(train_df, pair, params, "train_opt")
                bars_in_trade = sum((t.exit_bar_index - t.entry_bar_index) for t in trades)
                m = self.calculate_metrics(trades, eq, len(train_df), bars_in_trade, self.starting_equity, fin, pair)
                valid_count += 1
                if m.total_trades >= self.min_trades and m.max_drawdown <= self.dd_limit:
                    pf = min(m.profit_factor, 5.0)
                    pnl = m.net_pnl / 100.0
                    dd_pen = 100.0 * m.max_drawdown
                    score = pf + pnl - dd_pen
                    if score > best_score:
                        best_score = score
                        best_params = params.copy()
                # --- OPT_PROGRESS_V1 ---
                if (tested % 25 == 0) or (tested == total_combos):
                    try:
                        elapsed = max(1e-9, time.time() - opt_t0)
                        cps = tested / elapsed
                        eta = (total_combos - tested) / cps if cps > 0 else 0.0
                        self._hb.update_pair(
                            pair, 'optimize',
                            opt_tested=int(tested),
                            opt_total=int(total_combos),
                            opt_valid_count=int(valid_count),
                            opt_best_score=float(best_score),
                            opt_best_params=(best_params if best_params is not None else None),
                            opt_last_params=params,
                            opt_combos_per_sec=round(float(cps), 3),
                            opt_eta_seconds=round(float(eta), 2)
                        )
                        self._hb.update_global(
                            'optimize', current_pair=pair,
                            opt_tested=int(tested),
                            opt_total=int(total_combos),
                            opt_valid_count=int(valid_count),
                            opt_best_score=float(best_score),
                            opt_best_params=(best_params if best_params is not None else None),
                            opt_last_params=params,
                            opt_combos_per_sec=round(float(cps), 3),
                            opt_eta_seconds=round(float(eta), 2)
                        )
                    except Exception:
                        pass
                # --- OPT_PROGRESS_V1 ---

            except Exception:
                continue

        if best_params is None:
            best_params = {
                'k_tp': 0.5,
                'k_sl': 1.5,
                'tp_min_usdt': 0.22,
                'sl_min_usdt': 0.35,
                'target_profit_min_usdt': 0.15,
                'max_hold_bars': 15,
                'min_atr_multiplier': 1.0
            }
        return best_params

    def run_walkforward_backtest(self, pair: str, optimize: bool = True) -> Dict[str, Any]:
        t0 = time.time()
        try:
            # --- PHASE_UPDATES_V1 ---
            try:
                self._hb.update_pair(pair, 'load')
                self._hb.update_global('load', current_pair=pair)
            except Exception:
                pass
            # --- PHASE_UPDATES_V1 ---

            ohlc = self.load_ohlc_data(pair)
            ind = self.load_indicator_data(pair)

            if not self.validate_data_alignment(ohlc, ind, pair):
                raise ValueError("Alignment validation failed")

            # --- PHASE_UPDATES_V1 ---
            try:
                self._hb.update_pair(pair, 'merge')
                self._hb.update_global('merge', current_pair=pair)
            except Exception:
                pass
            # --- PHASE_UPDATES_V1 ---

            merged = ohlc.copy()
            for c in ind.columns:
                if c != 'timestamp':
                    merged[c] = ind[c].values

            # --- ENTRY_TUNING_V1 ---
            # rolling high computed on FULL merged df BEFORE split (prevents leakage via shift(1))
            try:
                lb = max(2, int(self.breakout_lookback))
                merged['roll_high'] = merged['high'].rolling(lb).max().shift(1)
            except Exception:
                merged['roll_high'] = np.nan
            # --- ENTRY_TUNING_V1 ---

            # --- PHASE_UPDATES_V1 ---
            try:
                self._hb.update_pair(pair, 'split')
                self._hb.update_global('split', current_pair=pair)
            except Exception:
                pass
            # --- PHASE_UPDATES_V1 ---

            train_df, test_df = self.split_train_test(merged)            # --- GA_EXTERNAL_PARAMS_V2 ---

            _defaults = {

                'k_tp': 0.5,

                'k_sl': 1.5,

                'tp_min_usdt': 0.22,

                'sl_min_usdt': 0.35,

                'target_profit_min_usdt': 0.15,

                'max_hold_bars': 15,

                'min_atr_multiplier': 1.0

            }

            if optimize:

                params = self.optimize_parameters(train_df, pair)

            else:

                fp = dict(self.fixed_params) if isinstance(getattr(self, 'fixed_params', None), dict) else {}

                for k,v in _defaults.items():

                    fp.setdefault(k, v)

                params = fp

            # --- GA_EXTERNAL_PARAMS_V2 ---

            self.optimized_params[pair] = params

            # --- PHASE_UPDATES_V1 ---
            try:
                self._hb.update_pair(pair, 'train')
                self._hb.update_global('train', current_pair=pair)
            except Exception:
                pass
            # --- PHASE_UPDATES_V1 ---

            train_trades, train_eq, train_fin = self.run_backtest_segment(train_df, pair, params, "train")
            train_bars_in_trade = sum((t.exit_bar_index - t.entry_bar_index) for t in train_trades)
            train_m = self.calculate_metrics(train_trades, train_eq, len(train_df), train_bars_in_trade,
                                             self.starting_equity, train_fin, pair)

            # --- PHASE_UPDATES_V1 ---
            try:
                self._hb.update_pair(pair, 'test')
                self._hb.update_global('test', current_pair=pair)
            except Exception:
                pass
            # --- PHASE_UPDATES_V1 ---

            test_trades, test_eq, test_fin = self.run_backtest_segment(test_df, pair, params, "test")
            test_bars_in_trade = sum((t.exit_bar_index - t.entry_bar_index) for t in test_trades)
            test_m = self.calculate_metrics(test_trades, test_eq, len(test_df), test_bars_in_trade,
                                            self.starting_equity, test_fin, pair)

            self.train_trades[pair] = train_trades
            self.test_trades[pair] = test_trades
            self.train_metrics[pair] = train_m
            self.test_metrics[pair] = test_m
            self.equity_curves[pair] = test_eq

            # --- PHASE_UPDATES_V1 ---
            try:
                self._hb.update_pair(pair, 'done_pair')
                self._hb.update_global('done_pair', current_pair=pair)
            except Exception:
                pass
            # --- PHASE_UPDATES_V1 ---

            dt = round(time.time() - t0, 2)
            return {
                'status': 'completed',
                'train_bars': int(len(train_df)),
                'test_bars': int(len(test_df)),
                'optimized_params': params,
                'train_metrics': train_m.to_dict(),
                'test_metrics': test_m.to_dict(),
                'train_trades': int(len(train_trades)),
                'test_trades': int(len(test_trades)),
                'processing_time_seconds': dt,
                'timestamp': datetime.now().isoformat()
            }

        except Exception as e:
            logger.error(f"{pair}: walkforward failed: {e}")
            logger.debug(traceback.format_exc())
            # --- PHASE_UPDATES_V1 ---
            try:
                msg = f"{type(e).__name__}: {str(e)}"
                self._hb.record_error(msg)
                self._hb.update_pair(pair, 'error', last_error=msg)
                self._hb.update_global('error', current_pair=pair, last_error=msg)
            except Exception:
                pass
            # --- PHASE_UPDATES_V1 ---

            return {'status': 'error', 'error': str(e), 'timestamp': datetime.now().isoformat()}

    def save_results(self, pair: str):
        if pair not in self.test_trades:
            return

        trades_file = self.results_dir / f"trades_{pair}_test.csv"
        if self.test_trades[pair]:
            df = pd.DataFrame([t.to_dict() for t in self.test_trades[pair]])
            df.to_csv(trades_file, index=False, encoding='utf-8')

        equity_file = self.results_dir / f"equity_{pair}_test.csv"
        if pair in self.equity_curves:
            self.equity_curves[pair].to_csv(equity_file, header=['equity'])

    def run_all(self, specific_pairs: Optional[List[str]] = None, optimize: bool = True) -> Dict[str, Any]:
        if specific_pairs:
            pairs = specific_pairs
        else:
            files = list(self.data_dir.glob("*_1m.csv"))
            pairs = [f.stem.replace("_1m", "") for f in files]

        # --- PHASE_UPDATES_V1 ---
        try:
            self._hb.update_global('load', current_pair=None, total_pairs=int(len(pairs)))
        except Exception:
            pass
        # --- PHASE_UPDATES_V1 ---

        for pair in pairs:
            rep = self.run_walkforward_backtest(pair, optimize=optimize)
            self.report['pairs'][pair] = rep
            if rep.get('status') == 'completed':
                self.save_results(pair)

        total_time = round(time.time() - self.start_time, 2)
        completed = sum(1 for r in self.report['pairs'].values() if r.get('status') == 'completed')
        errors = sum(1 for r in self.report['pairs'].values() if r.get('status') != 'completed')

        total_test_trades = sum(self.test_metrics[p].total_trades for p in self.test_metrics) if self.test_metrics else 0
        total_test_pnl = sum(self.test_metrics[p].net_pnl for p in self.test_metrics) if self.test_metrics else 0.0
        total_test_fees = sum(self.test_metrics[p].total_fees for p in self.test_metrics) if self.test_metrics else 0.0
        avg_dd = (sum(self.test_metrics[p].max_drawdown for p in self.test_metrics) / len(self.test_metrics)) if self.test_metrics else 0.0

        self.report['summary'] = {
            'total_pairs_processed': int(len(self.report['pairs'])),
            'completed': int(completed),
            'errors': int(errors),
            'total_test_trades': int(total_test_trades),
            'total_test_net_pnl': float(total_test_pnl),
            'total_test_fees': float(total_test_fees),
            'avg_test_drawdown': float(avg_dd),
            'total_time_seconds': float(total_time),
            'results_directory': str(self.results_dir),
            'optimized_parameters': self.optimized_params
        }

        # --- PHASE_UPDATES_V1 ---
        try:
            self._hb.update_global('done_all', current_pair=None, total_pairs=int(len(self.report['pairs'])))
        except Exception:
            pass
        # --- PHASE_UPDATES_V1 ---

        return self.report

    def get_report(self) -> Dict[str, Any]:
        return self.report


def main():
    p = argparse.ArgumentParser(description="Walk-forward backtest v3 (ATR TP/SL)")
    p.add_argument("--debug_signals", action="store_true", help="Print entry filter pass statistics (diagnostic)")

    # --- ENTRY_TUNING_V1 ---
    p.add_argument('--entry_variant', type=int, default=0, 
                   help="0=legacy (trend+rsi+bbmid+atr_gate), 1=breakout, 2=hybrid (legacy OR breakout)")
    p.add_argument('--rsi_buy', type=float, default=35.0, help="RSI threshold for legacy leg (rsi_14 < rsi_buy)")
    p.add_argument('--use_trend_filter', type=int, default=1, choices=[0,1], help="Use EMA9>EMA21 filter in legacy leg")
    p.add_argument('--use_bb_filter', type=int, default=1, choices=[0,1], help="Use close<BB mid filter in legacy leg")
    p.add_argument('--breakout_lookback', type=int, default=20, help="Rolling high lookback for breakout leg")
    p.add_argument('--breakout_atr_k', type=float, default=0.25, help="Breakout buffer: close > roll_high + breakout_atr_k * atr_14")
    # --- GA_EXTERNAL_PARAMS_V2 ---

    # If provided, these fixed TP/SL/hold params will be used when --no_optimize is set.

    p.add_argument('--k_tp', type=float, default=None)

    p.add_argument('--k_sl', type=float, default=None)

    p.add_argument('--tp_min_usdt', type=float, default=None)

    p.add_argument('--sl_min_usdt', type=float, default=None)

    p.add_argument('--target_profit_min_usdt', type=float, default=None)

    p.add_argument('--max_hold_bars', type=int, default=None)

    p.add_argument('--min_atr_multiplier', type=float, default=None)

    # --- GA_EXTERNAL_PARAMS_V2 ---

    # --- ENTRY_TUNING_V1 ---
    default_project_dir = Path(__file__).resolve().parent
    p.add_argument('--data_dir', type=str, default=str(default_project_dir / "SCALPING_DATA_PARQUET"))
    p.add_argument('--cache_dir', type=str, default=str(default_project_dir / "cache" / "indicators"))
    p.add_argument('--results_dir', type=str, default=str(default_project_dir / "results"))
    p.add_argument('--pairs', type=str, nargs='+')
    p.add_argument('--starting_equity', type=float, default=500.0)
    p.add_argument('--train_ratio', type=float, default=0.7)
    p.add_argument('--max_bars', type=int, default=0, help='Limit bars for fast mode (0=all)')
    p.add_argument('--notional_usdt', type=float, default=50.0)
    p.add_argument('--fee_taker', type=float, default=0.00055)
    p.add_argument('--fee_maker', type=float, default=0.0002)
    p.add_argument('--maker_exit', action='store_true')
    p.add_argument('--slip_buffer_usdt', type=float, default=0.05)
    p.add_argument('--dd_limit', type=float, default=0.10)
    p.add_argument('--min_trades', type=int, default=30)
    p.add_argument('--no_optimize', action='store_true')
    p.add_argument('--verbose', action='store_true')
    p.add_argument('--output', type=str, default=str(default_project_dir / "results" / "backtest_report.json"))

    args = p.parse_args()


    # --- PAIR_NORMALIZE_V1 ---
    def _norm_pair(x):
        try:
            s = str(x).strip().upper()
            return s.replace("/", "").replace("-", "").replace("_", "")
        except Exception:
            return x
    if getattr(args, "pairs", None):
        try:
            args.pairs = [_norm_pair(p) for p in args.pairs if str(p).strip()]
        except Exception:
            pass
    # --- PAIR_NORMALIZE_V1 ---
    if args.verbose:
        logging.getLogger().setLevel(logging.DEBUG)
        logger.setLevel(logging.DEBUG)

    if not DATA_LOADER_AVAILABLE:
        print(json.dumps({'error': 'data_loader module is not available'}, indent=2))
        return 1

    # --- GA_EXTERNAL_PARAMS_V2 ---

    fixed_params = None

    fp_keys = ['k_tp','k_sl','tp_min_usdt','sl_min_usdt','target_profit_min_usdt','max_hold_bars','min_atr_multiplier']

    any_fp = any(getattr(args, k, None) is not None for k in fp_keys)

    if any_fp:

        fixed_params = {k: getattr(args, k, None) for k in fp_keys if getattr(args, k, None) is not None}

        args.no_optimize = True

    # --- GA_EXTERNAL_PARAMS_V2 ---



    runner = BacktestRunnerV3(
        data_dir=Path(args.data_dir),
        cache_dir=Path(args.cache_dir),
        results_dir=Path(args.results_dir),
        starting_equity=args.starting_equity,
        train_ratio=args.train_ratio,
        notional_usdt=args.notional_usdt,
        fee_taker=args.fee_taker,
        fee_maker=args.fee_maker,
        use_maker_exit=args.maker_exit,
        slip_buffer_usdt=args.slip_buffer_usdt,
        dd_limit=args.dd_limit,
        min_trades=args.min_trades,
        max_bars=args.max_bars,
        entry_variant=args.entry_variant,
        rsi_buy=args.rsi_buy,
        use_trend_filter=args.use_trend_filter,
        use_bb_filter=args.use_bb_filter,
        breakout_lookback=args.breakout_lookback,
        breakout_atr_k=args.breakout_atr_k,

        fixed_params=fixed_params

    )
    runner.debug_signals = bool(getattr(args, "debug_signals", False))

    report = runner.run_all(specific_pairs=args.pairs, optimize=(not args.no_optimize))
    full = runner.get_report()
    report_json = json.dumps(full, indent=2, default=str)

    out = Path(args.output)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(report_json, encoding='utf-8')

    print(report_json)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())




