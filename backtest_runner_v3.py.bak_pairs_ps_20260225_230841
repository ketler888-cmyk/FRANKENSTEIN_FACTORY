class PositionState:
    def __init__(self):
        self.is_open = False
        self.entry_time = None
        self.entry_price = 0.0
        self.quantity = 0.0
        self.entry_bar_index = -1
        self.tp_price = 0.0
        self.sl_price = 0.0
        self.max_hold_bars = 0
        self.bars_held = 0
        self.entry_fee_paid = False
        self.atr_value = 0.0
        self.tp_usdt = 0.0
        self.sl_usdt = 0.0

    def open_position(self, entry_time, entry_price, quantity, entry_bar_index, tp_price, sl_price, max_hold_bars,
                      atr_value, tp_usdt, sl_usdt):
        self.is_open = True
        self.entry_time = entry_time
        self.entry_price = entry_price
        self.quantity = quantity
        self.entry_bar_index = entry_bar_index
        self.tp_price = tp_price
        self.sl_price = sl_price
        self.max_hold_bars = int(max_hold_bars)
        self.bars_held = 0
        self.entry_fee_paid = False
        self.atr_value = float(atr_value)
        self.tp_usdt = float(tp_usdt)
        self.sl_usdt = float(sl_usdt)

    def increment_hold_time(self):
        if self.is_open:
            self.bars_held += 1

    def close_position(self):
        self.__init__()


class BacktestRunnerV3:
    def entry_signal(self, *args, **kwargs):
        """Compat entry filter.
        Supports:
          - entry_signal(e9, e21, rr, cc, mid)
          - entry_signal(row)
        Returns True/False.
        """
        try:
            if len(args) == 1 and args[0] is not None:
                row = args[0]
                # try mapping-like
                get = (row.get if hasattr(row, 'get') else None)
                if get:
                    e9  = get('ema9', None)
                    e21 = get('ema21', None)
                    rr  = get('rsi', None)
                    cc  = get('close', None)
                    mid = get('bb_mid', None)
                else:
                    # object-like
                    e9  = getattr(row, 'ema9', None)
                    e21 = getattr(row, 'ema21', None)
                    rr  = getattr(row, 'rsi', None)
                    cc  = getattr(row, 'close', None)
                    mid = getattr(row, 'bb_mid', None)
            else:
                # expected: (e9,e21,rr,cc,mid)
                e9, e21, rr, cc, mid = (args + (None, None, None, None, None))[:5]
    
            # if indicators missing -> do not block
            def _f(x):
                try:
                    return float(x)
                except Exception:
                    return None
    
            e9f  = _f(e9)
            e21f = _f(e21)
            rrf  = _f(rr)
            ccf  = _f(cc)
            midf = _f(mid)
    
            ok_trend = True
            if (e9f is not None) and (e21f is not None):
                ok_trend = (e9f >= e21f)
    
            ok_rsi = True
            if rrf is not None:
                # wide default window (doesn't choke)
                ok_rsi = (rrf >= 30.0) and (rrf <= 70.0)
    
            ok_bb = True
            if (ccf is not None) and (midf is not None):
                ok_bb = (ccf <= midf)
    
            return bool(ok_trend and ok_rsi and ok_bb)
        except Exception:
            return True


