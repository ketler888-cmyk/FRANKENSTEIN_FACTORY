def _safe_write_json_atomic(path: Path, obj: Dict[str, Any]) -> None:
    """Write JSON atomically (tmp + fsync + os.replace). Never raises."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name('.' + path.name + '.tmp')
        data = json.dumps(obj, ensure_ascii=False, indent=2, default=str)
        with open(tmp, 'w', encoding='utf-8') as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(str(tmp), str(path))
    except Exception:
        return


class HeartbeatManager:
    """Lightweight heartbeat/progress writer for long-running backtests."""
    
    def __init__(self, results_dir: Path, start_time: float):
        self.results_dir = Path(results_dir)
        self.start_time = float(start_time)
        self.errors_count = 0
        self.last_error = None
        self._pid = os.getpid()
        self._python = sys.version.split()[0]
        try:
            self._host = socket.gethostname()
        except Exception:
            self._host = None
        try:
            self._platform = platform.platform()
        except Exception:
            self._platform = None

    def record_error(self, msg: str) -> None:
        try:
            self.errors_count += 1
            self.last_error = str(msg)[:500]
        except Exception:
            return

    def _base(self, phase: str, pair: Optional[str]) -> Dict[str, Any]:
        now_iso = datetime.utcnow().isoformat() + 'Z'
        return {
            'ts_iso': now_iso,
            'last_update_iso': now_iso,
            'elapsed_seconds': round(time.time() - self.start_time, 2),
            'phase': phase,
            'pair': pair,
            'pid': self._pid,
            'python': self._python,
            'host': self._host,
            'platform': self._platform,
            'errors_count': self.errors_count,
            'last_error': self.last_error,
        }

    def update_global(self, phase: str, **fields: Any) -> None:
        obj = self._base(phase=phase, pair=None)
        obj.update(fields)
        _safe_write_json_atomic(self.results_dir / 'heartbeat_global.json', obj)

    def update_pair(self, pair: str, phase: str, **fields: Any) -> None:
        obj = self._base(phase=phase, pair=pair)
        obj.update(fields)
        _safe_write_json_atomic(self.results_dir / f'heartbeat_{pair}.json', obj)
