# ================= FRANKEN | CODE-ONLY MIRROR =================
# --- venv ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# --- data / results / caches / logs ---
SCALPING_DATA*/
results*/
cache/
logs/
*_cache/
*.parquet
*.csv
*.tsv
*.duckdb
*.db
*.sqlite
*.sqlite3
*.log

# --- archives / dumps ---
*.zip
*.7z
*.rar

# --- ops runtime ---
ops/heartbeat.json
ops/*.pid
ops/STOP_FACTORY
ops/vendor.lock.json

# --- backups/audits/sources ---
_BACKUPS_MIRROR/
BACKUPS_MIRROR/
_sources/
AUDIT_*/
_AUDIT_*/
ЗЕРКАЛЬНЫЕ_ОТЧЕТЫ/
КОНТЕКСТНЫЙ_ЧАТ/
ЖЕЛЕЗНЫЙ_ЗОНД/

