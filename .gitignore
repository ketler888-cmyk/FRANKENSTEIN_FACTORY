SCALPING_DATA*/
SCALPING_DATA_PARQUET*/
SCALPING_DATA_RAW*/
results*/
results_ga*/
cache/
logs/
*_cache/

# datasets / binaries
*.parquet
*.csv
*.tsv
*.duckdb
*.db
*.sqlite
*.sqlite3

# runtime artifacts
*.log
*.pid
ops/*.pid
ops/heartbeat.json
ops/STOP_FACTORY

